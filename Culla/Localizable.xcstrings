          "stringUnit" : {
            "state" : "translated",
            "value" : "Resminamalar Culla çeşme kodunyň içinde"
          }
        }
      }
    },
    "The file is not an image Culla can open." : {
      "comment" : "Why a photo has no thumbnail or analysis: shown in the inspector and tile tooltip for an unreadable file. Culla is the app's name.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
