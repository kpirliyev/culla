          "stringUnit" : {
            "state" : "translated",
            "value" : "Her dublikat toplumy barada karar berildi"
          }
        }
      }
    },
    "Every photo in %@ has a decision." : {
      "comment" : "A note at the bottom of the photo area when the last photo of a group was decided. %@ is the group's name, such as 'Blurry' or 'Eyes Closed'.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
