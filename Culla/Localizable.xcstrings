{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ applies" : {
      "comment" : "Review and Apply: a small caption beside the 'Keep Culling' button saying which key runs the apply. %@ is the key, such as ⇧⌘↩ (never translated). Little room.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — применить"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ulanýar"
          }
        }
      }
    },
    "%@ from left" : {
      "comment" : "Row label in the face strip under stack review and the loupe when Culla could not follow people from frame to frame, so faces are by position: '2nd from left'. %@ is an ordinal number already formatted for the language. Little room: row labels are 100 points wide.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ слева"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "çepden %@"
          }
        }
      }
    },
    "%@ in %@: %@" : {
      "comment" : "Tooltip of a face in the face strip under stack review and the loupe: 'Person 2 in IMG_0042.jpg: eyes 0.82'. %1$@ is the person ('Person 2', '2nd from left' or 'Face 1'), %2$@ the file name, %3$@ the eye reading.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ in %2$@: %3$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ в %2$@: %3$@"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@: %3$@"
          }
        }
      }
    },
    "%@ is already the best pick." : {
      "comment" : "A notice when Make Best Pick is used on the frame that already is the stack's best pick. %@ is the photo's file name.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — уже лучший кадр."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ eýýäm iň gowy kadr."
          }
        }
      }
    },
    "%@ is now the best pick. Culla keeps your choice." : {
      "comment" : "A notice after Make Best Pick. %@ is the photo's file name. Culla is the app's name; 'keeps your choice' means it will not change it when it regroups.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ теперь лучший кадр. Culla сохранит ваш выбор."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ indi iň gowy kadr. Culla saýlawyňyzy saklaýar."
          }
        }
      }
    },
    "%@ likely" : {
      "comment" : "The value of the inspector's Lens smudge row: '35% likely', how likely the lens was smudged. %@ is the percentage, already formatted.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "вероятность %@"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ähtimallygy %@"
          }
        }
      }
    },
    "%@ next reject" : {
      "comment" : "Review and Apply, the bar under a reject shown large: key hint. %@ is the keys, such as '← →' (never translated). Little room.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ следующее фото"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ indiki ret edilen"
          }
        }
      }
    },
    "%@ of %lld GB" : {
      "comment" : "How much of the cache limit thumbnails use, in Settings ▸ Performance: '1.2 GB of 5 GB'. %1$@ is the size used, already formatted with its unit; %2$lld is the limit in gigabytes; GB is the abbreviation for gigabytes.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of %2$lld GB"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ из %2$lld ГБ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$lld GB"
          }
        }
      }
    },
    "%@ open" : {
      "comment" : "The value of the inspector's Eyes row: how open the most closed eyes are, from 0 (closed) to 1 (wide open): '0.82 open'. %@ is the number with two decimals.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "открыты на %@"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "açyklygy %@"
          }
        }
      }
    },
    "%@ · Certain" : {
      "comment" : "In the loupe's header bar, above the photo and stack review: a problem badge naming its tier, such as 'Eyes closed · Certain'. %@ is the problem's name. 'Certain' means Culla is sure of it (as opposed to Likely). Short; little room.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Точно"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Şübhesiz"
          }
        }
      }
    },
    "%@ · Likely" : {
      "comment" : "In the loupe's header bar, above the photo: a problem badge naming its tier, such as 'Blurry · Likely'. %@ is the problem's name. 'Likely' means past the threshold but not sure (as opposed to Certain). Short; little room.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
