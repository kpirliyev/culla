            "state" : "translated",
            "value" : "Culla JPEG, HEIC we RAW faýllaryny gözleýär, içki bukjalarda hem."
          }
        }
      }
    },
    "Culla quit while applying “%@”. Undo what was done?" : {
      "comment" : "A notice docked above the photos when the shoot is opened after Culla quit in the middle of an apply. %@ is the apply's title, such as 'Move 12 Photos to _Rejected'.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
