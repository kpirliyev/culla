    },
    "%@, %lld of %lld left to review" : {
      "comment" : "VoiceOver label of a sidebar group: 'Blurry, 3 of 12 left to review'. %1$@ is the group's name; the first number is how many photos have no decision yet, the second how many photos are in the group.",
