    "Culla could not read the folder. %@" : {
      "comment" : "Message of the alert shown when a folder could not be read. %@ is the system's own description of the error, a full sentence. Culla is the app's name.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать папку. %@"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culla bukjany okap bilmedi. %@"
          }
        }
      }
    },
    "Culla finds the likely rejects in a shoot — closed eyes, blur, bad exposure, duplicates and bursts of lookalikes — and you decide each one from the keyboard. Nothing is moved until you review and apply, and applying can be undone." : {
      "comment" : "The first-run introduction's text on the welcome screen. A shoot is a folder of photos from one photo session; 'review and apply' is a step of the app (Review and Apply).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culla находит в съёмке кандидатов на отклонение — закрытые глаза, нерезкость, неудачную экспозицию, дубликаты и серии похожих кадров, — а вы принимаете решение по каждому с клавиатуры. Ничего не перемещается, пока вы не проверите и не примените решения, а применение можно отменить."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culla bukjadan ret edilmegi ähtimal suratlary tapýar — ýumuk gözler, bulaşyklyk, ýaramaz ekspozisiýa, dublikatlar we meňzeş kadrlaryň tapgyrlary — siz bolsa her biri barada klawiaturadan karar berýärsiňiz. Gözden geçirip ulanýançaňyz hiç zat geçirilmeýär, ulanylan zady bolsa yzyna alyp bolýar."
          }
        }
      }
    },
    "Culla icon" : {
      "comment" : "VoiceOver label for the app icon at the top of the About window. Culla is the app's name, never translated.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
