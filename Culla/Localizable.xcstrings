    "%@ · Likely: past the threshold, worth a look" : {
      "comment" : "Tooltip of a problem badge in the loupe's header when Culla is not sure. %@ is the problem's name, such as 'Blurry'.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
