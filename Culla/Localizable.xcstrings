        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu faýl Culla açyp bilýän surat däl."
          }
        }
      }
    },
    "The folder may have been moved, or it is on a drive or card that is not connected." : {
      "comment" : "Message of the alert shown when the folder being opened does not exist.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
