    "%lld RAW files now shown on their own will be paired with the JPEG or HEIC files of the same name and no longer appear as separate photos." : {
      "comment" : "First sentence of the confirmation alert for switching on 'Treat RAW+JPEG as one photo'. %lld is the number of RAW files now shown as photos of their own; each will be paired with the JPEG or HEIC file of the same name and stop being shown as a separate photo (its decision and rating are lost, said in the next sentence).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld RAW file now shown on its own will be paired with the JPEG or HEIC file of the same name and no longer appear as a separate photo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld RAW files now shown on their own will be paired with the JPEG or HEIC files of the same name and no longer appear as separate photos."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld файла RAW, показанных сейчас отдельно, будут объединены в пары с одноимёнными файлами JPEG или HEIC и перестанут показываться как отдельные фото."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld файлов RAW, показанных сейчас отдельно, будут объединены в пары с одноимёнными файлами JPEG или HEIC и перестанут показываться как отдельные фото."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld файл RAW, показанный сейчас отдельно, будет объединён в пару с одноимённым файлом JPEG или HEIC и перестанет показываться как отдельное фото."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld файлов RAW, показанных сейчас отдельно, будут объединены в пары с одноимёнными файлами JPEG или HEIC и перестанут показываться как отдельные фото."
                }
              }
            }
          }
        },
        "tk" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Häzir aýratyn görkezilýän %lld RAW faýly şol atly JPEG ýa-da HEIC faýly bilen jübütlener we indi aýratyn surat bolup görkezilmez."
                }
