    },
    "Switch between the grid and one large photo" : {
      "comment" : "First-run introduction, beside the loupe key (Space): switches between the grid of thumbnails and the large single-photo view. Imperative description.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
