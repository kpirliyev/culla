    },
    "“%@” can’t be reached: its card or drive was disconnected, or the folder was moved or deleted. Every decision is kept, and Culla carries on when it is back." : {
      "comment" : "The line shown at the top of the window while the shoot folder cannot be reached. %@ is the shoot folder's name.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка «%@» недоступна: карта или диск отключены либо папка перемещена или удалена. Все решения сохранены, и Culla продолжит работу, когда папка снова станет доступна."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
