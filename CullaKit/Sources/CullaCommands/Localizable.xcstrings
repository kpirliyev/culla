      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidecars (.xmp) are written beside %#@kept@ and %#@rejected@, recording the decision and star rating. Existing sidecars keep everything else in them. Image files are never changed."
          },
          "substitutions" : {
            "kept" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
