    "Accept 1 Exact Duplicate Set" : {
      "comment" : "Name of an undoable step, shown in the Edit menu as 'Undo <name>' and 'Redo <name>'. Like 'Accept All Exact Duplicates' when there was only one set of identical files.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принять 1 набор точных дубликатов"
