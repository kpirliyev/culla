          "stringUnit" : {
            "state" : "translated",
            "value" : "Derňelýär: %1$lld / %2$lld"
          }
        }
      }
    },
    "Another file is now at its original place." : {
      "comment" : "In the report after Undo Apply (taking back the changes Culla made to the files). Why a file was not put back: Culla never replaces another file.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На его прежнем месте теперь другой файл."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onuň öňki ýerinde indi başga faýl bar."
          }
        }
      }
    },
    "Any main face" : {
      "comment" : "An option of a menu in Settings and the tuning panel. Menu 'Group photo rule': a photo is flagged if any main face has closed eyes.",
