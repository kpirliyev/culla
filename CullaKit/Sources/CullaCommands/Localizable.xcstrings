{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ cannot bring it back." : {
      "comment" : "Ends a notice or alert after a change, saying how to take it back. In a warning that a change cannot be undone. %@ is the Undo key, such as ⌘Z (never translated).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ этого не вернёт."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bilen muny yzyna alyp bolmaýar."
          }
        }
      }
    },
    "%@ is kept for %@ and cannot be changed." : {
      "comment" : "A warning in Settings ▸ Keys when a key belongs to macOS or a fixed menu item. %1$@ is the key, such as ⌘Q (never translated); %2$@ is what uses it, such as 'Quit Culla' or 'the app switcher'. Rephrase freely, for example as '%1$@ is reserved: %2$@'.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is kept for %2$@ and cannot be changed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетание %1$@ занято: %2$@. Изменить его нельзя."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ «%2$@» üçin berkidilen, ony üýtgedip bolmaýar."
          }
        }
      }
    },
    "%@ is used by %@." : {
      "comment" : "A warning in Settings ▸ Keys when a key is already taken. %1$@ is the key, such as ⇧X (never translated); %2$@ is the command's name, such as 'Reject All Certain in Group'.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is used by %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ уже используется: %2$@."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eýýäm «%2$@» üçin ulanylýar."
          }
        }
      }
    },
    "%@ puts it back." : {
      "comment" : "Ends a notice or alert after a change, saying how to take it back. After a frame was split out of its stack. %@ is the Undo key, such as ⌘Z (never translated).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вернёт кадр в серию."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bilen ony öňki ýerine gaýtaryp bolýar."
          }
        }
      }
    },
    "%@ s" : {
      "comment" : "A value in seconds with a decimal beside a slider in Settings and the tuning panel, such as '1.5 s'. %@ is the number; 's' is the abbreviation.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
