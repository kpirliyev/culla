        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 takyk dublikat toplumyny kabul et"
          }
        }
      }
    },
    "Accept All Exact Duplicates" : {
      "comment" : "Menu item in the menu bar, in title case as macOS menus use it; also listed under this name in Help ▸ Keyboard Shortcuts and Settings ▸ Keys (without a trailing ellipsis). Photo menu, in duplicate review: keeps one copy of every set of identical files and rejects the rest, in one step. Name of an undoable step, shown in the Edit menu as 'Undo <name>' and 'Redo <name>'. Also used as that name.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принять все точные дубликаты"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähli takyk dublikatlary kabul et"
          }
        }
      }
    },
    "Accept Duplicate Set" : {
      "comment" : "Name of an undoable step, shown in the Edit menu as 'Undo <name>' and 'Redo <name>'. Keeping the chosen copy of a set of duplicates and rejecting the other copies. Also a menu item in duplicate review.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принять набор дубликатов"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dublikat toplumyny kabul et"
          }
        }
      }
    },
    "Accept Stack" : {
      "comment" : "Menu item in the menu bar, in title case as macOS menus use it; also listed under this name in Help ▸ Keyboard Shortcuts and Settings ▸ Keys (without a trailing ellipsis). Photo menu, in stack review: keeps the best pick of the stack and rejects the other frames (glossary: stack, best pick). Name of an undoable step, shown in the Edit menu as 'Undo <name>' and 'Redo <name>'. Also used as that name.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принять серию"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapgyry kabul et"
          }
        }
      }
    },
    "Accept Stack or Set" : {
      "comment" : "Name of a command in the list of Settings ▸ Keys and Help ▸ Keyboard Shortcuts, where the menu title changes with the state (Show/Hide). Title case. Return: accepts the stack (in stack review) or the duplicate set (in duplicate review) on screen.",
      "extractionState" : "manual",
