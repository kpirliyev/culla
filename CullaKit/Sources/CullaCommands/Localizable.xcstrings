    },
    "Adjust Detection…" : {
      "comment" : "Menu item in the menu bar, in title case as macOS menus use it; also listed under this name in Help ▸ Keyboard Shortcuts and Settings ▸ Keys (without a trailing ellipsis). Analysis menu: opens the panel that sets how strict each detector is (glossary: detection tuning).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроить обнаружение…"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýüze çykaryşy sazla…"
          }
        }
      }
    },
    "Aesthetics below" : {
      "comment" : "Label of a control in the detection tuning panel and in Settings, beside a slider, switch or menu. Sentence case, at most about 30 characters. Settings ▸ Other pane and the tuning panel; the label of a slider, followed by its value (a slider's label that ends in 'below', 'above', 'within' or 'up to' reads into the number after it).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эстетика ниже"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetika şundan pes"
          }
        }
      }
    },
    "After %@ on one photo, the next one is shown." : {
      "comment" : "Note under the setting 'Advance after a decision' in Settings ▸ General. %@ is the keys for keep, reject and clear decision, such as 'P, X or U' (keys never translated, the list is already in your language).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После нажатия %@ на одном фото показывается следующее."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir suratda %@ basylandan soň indiki surat görkezilýär."
          }
        }
      }
    },
    "After a decision on one photo, the next one is shown." : {
      "comment" : "Note under the setting 'Advance after a decision' in Settings ▸ General, when no key is set for keep, reject or clear.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После решения по одному фото показывается следующее."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir surat barada karar berlenden soň indiki surat görkezilýär."
          }
        }
      }
    },
    "All faces" : {
      "comment" : "An option of a menu in Settings and the tuning panel. Menu 'Group photo rule': a photo is flagged only if all main faces have closed eyes.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
