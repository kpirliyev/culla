          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähli ýüzler"
          }
        }
      }
    },
    "Analysing %lld of %lld" : {
      "comment" : "The analysis progress in the toolbar: 'Analysing 420 of 1,240'. The first number is the photos analysed so far, the second all photos of the shoot (glossary: analysis).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
