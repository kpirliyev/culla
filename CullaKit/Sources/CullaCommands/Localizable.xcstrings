        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saýlananlary tapgyra goş"
          }
        }
      }
    },
    "Add to Stack" : {
      "comment" : "Name of an undoable step, shown in the Edit menu as 'Undo <name>' and 'Redo <name>'. Joining photos into a stack.",
