          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapgyry ýa-da toplumy kabul et"
          }
        }
      }
    },
    "Accidental shots" : {
      "comment" : "Label of a control in the detection tuning panel and in Settings, beside a slider, switch or menu. Sentence case, at most about 30 characters. Settings ▸ Other pane and the tuning panel; the label of a switch.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
