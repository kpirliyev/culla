        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sek"
          }
        }
      }
    },
    "%@ takes it back in one step." : {
      "comment" : "Ends a notice or alert after a change, saying how to take it back. After a change made in one step to many photos. %@ is the Undo key, such as ⌘Z (never translated).",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вернёт всё одним шагом."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bilen bir ädimde yzyna alyp bolýar."
          }
        }
      }
    },
    "%@ takes it back." : {
      "comment" : "Ends a notice or alert after a change, saying how to take it back. %@ is the Undo key, such as ⌘Z (never translated).",
