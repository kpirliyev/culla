    "Add Selection to Stack" : {
      "comment" : "Menu item in the menu bar, in title case as macOS menus use it; also listed under this name in Help ▸ Keyboard Shortcuts and Settings ▸ Keys (without a trailing ellipsis). Photo menu: joins the selected photos into one stack.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
