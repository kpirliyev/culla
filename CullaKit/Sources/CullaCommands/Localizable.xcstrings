            "state" : "translated",
            "value" : "Islendik esasy ýüz"
          }
        }
      }
    },
    "Apply" : {
      "comment" : "Menu item in the menu bar, in title case as macOS menus use it; also listed under this name in Help ▸ Keyboard Shortcuts and Settings ▸ Keys (without a trailing ellipsis). The primary action of the Review and Apply screen: carries out the decisions on the files. A verb.",
      "extractionState" : "manual",
