    "How a stack's best frame is chosen. Ties on sharpness go to faces, then to aesthetics." : {
      "comment" : "Note under the heading 'Best pick' in Settings ▸ Similarity.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
