{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. Settings ▸ Keys: a command remapped by clicking its key and pressing another takes effect at once in the key router and the menus; a key already in use shows a warning naming the other command; fixed keys are refused; Reset All brings the defaults back."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"group": "allPhotos"},
    {"settings": {"advanceAfterDecision": false}},
    {"click": "horizon_0.jpg"},
    {"settingsWindow": "keys"},
    {"bindKey": "keep"},
    {"expect": {"settingsWindow.recording": "keep"}},
    {"snapshot": "01-recording", "window": "settings"},
    {"keyRecorder": "cancel"},
    {"bindKey": "keep", "chord": "k"},
    {"expect": {"keyMap.keep": ["k"], "menuKeys.keep": "K", "settingsWindow.recording": null, "keyConflicts": []}},
    {"key": "k"},
    {"expect": {"photo:horizon_0.jpg.decision": "kept"}},
    {"snapshot": "02-keep-on-k", "window": "settings"},

    {"log": "U is Clear Decision's: a warning names it, and nothing changes until the choice is made."},
    {"bindKey": "reject", "chord": "u"},
    {"expect": {"settingsWindow.recording": "reject", "settingsWindow.conflict": "U is used by Clear Decision.", "keyMap.reject": ["x"], "keyMap.clearDecision": ["u"]}},
    {"snapshot": "03-conflict-warning", "window": "settings"},
    {"keyRecorder": "cancel"},
    {"expect": {"keyMap.reject": ["x"], "settingsWindow.conflict": null}},
    {"bindKey": "reject", "chord": "u", "replace": true},
    {"expect": {"keyMap.reject": ["u"], "keyMap.clearDecision": [], "menuKeys.reject": "U", "menuKeys.clearDecision": null}},
    {"click": "horizon_1.jpg"},
    {"key": "u"},
    {"expect": {"photo:horizon_1.jpg.decision": "rejected"}},

    {"log": "⌘Q is fixed."},
    {"bindKey": "undo", "chord": "cmd+q"},
    {"expect": {"settingsWindow.conflict": "⌘Q is kept for Quit Culla and cannot be changed.", "keyMap.undo": ["cmd+z"]}},
    {"snapshot": "04-fixed-key", "window": "settings"},
    {"keyRecorder": "cancel"},

    {"log": "Reset All."},
    {"keyRecorder": "resetAll"},
    {"expect": {"keyMap.keep": ["p"], "keyMap.reject": ["x"], "keyMap.clearDecision": ["u"], "menuKeys.keep": "P", "menuKeys.clearDecision": "U"}},
    {"click": "horizon_2.jpg"},
    {"key": "p"},
    {"expect": {"photo:horizon_2.jpg.decision": "kept"}},
    {"snapshot": "05-reset-all", "window": "settings"},
    {"settingsWindow": "close"},
    {"quit": true}
  ]
}
