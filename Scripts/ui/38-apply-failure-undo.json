{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "A failure part-way: the run stops, the banner says what moved and what did not, and Undo What Was Done restores the folder exactly."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"saveHash": "38-original"},
    {"group": "allPhotos"},
    {"click": "horizon_1.jpg"},
    {"key": "x"},
    {"click": "sonoma_3.jpg"},
    {"key": "x"},
    {"click": "horizon_0_under.jpg"},
    {"key": "x"},
    {"click": "horizon_2.jpg"},
    {"key": "x"},
    {"click": "horizon_3.jpg"},
    {"key": "x"},
    {"wait": "idle"},
    {"applyScreen": "open"},
    {"fault": {"failAt": 4}},
    {"key": "shift+cmd+return"},
    {"wait": "applied"},
    {"snapshot": "01-partial-failure"},
    {"dump": "01-failed", "listing": true},
    {"expect": {"apply.result.state": "failed", "apply.banner.state": "failed", "undoTitle": "Undo Interrupted Apply: Move 5 Photos to _Rejected…"}},
    {"bannerAction": "undo"},
    {"snapshot": "02-undone"},
    {"expectHash": "38-original"},
    {"expect": {"totals.photos": 35, "totals.rejected": 5, "apply.undoable": null}},
    {"quit": true}
  ]
}
