{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. The grid's context menu (on the selection when the photo is in it, else on the photo), rubber-band selection, and Open Recent > Clear Menu."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"click": "sonoma_1.jpg"},
    {"click": "sonoma_3.jpg", "modifiers": "cmd"},
    {"expect": {"selectionCount": 2}},
    {"contextMenu": "sonoma_3.jpg", "items": ["Keep 2 Photos", "Reject 2 Photos", "Clear 2 Decisions", "Rating ▸ No Rating",
      "Rating ▸ 1 Star", "Rating ▸ 2 Stars", "Rating ▸ 3 Stars", "Rating ▸ 4 Stars", "Rating ▸ 5 Stars", "Reveal in Finder", "Copy 2 File Names"]},
    {"contextMenu": "sonoma_3.jpg", "item": "Reject 2 Photos"},
    {"expect": {"photo:sonoma_1.jpg.decision": "rejected", "photo:sonoma_3.jpg.decision": "rejected", "selectionCount": 2,
                "undoTitle": "Undo Reject 2 Photos"}},
    {"contextMenu": "sonoma_1.jpg", "item": "5 Stars"},
    {"expect": {"photo:sonoma_1.jpg.rating": 5, "photo:sonoma_3.jpg.rating": 5}},
    {"contextMenu": "sonoma_1.jpg", "item": "Copy 2 File Names"},
    {"expect": {"lastFileAction": "copy: sonoma_1.jpg, sonoma_3.jpg"}},

    {"log": "A photo outside the selection: the menu selects it and acts on it alone."},
    {"contextMenu": "sonoma_4.jpg", "item": "Keep"},
    {"expect": {"photo:sonoma_4.jpg.decision": "kept", "photo:sonoma_1.jpg.decision": "rejected", "selectionCount": 1}},
    {"contextMenu": "horizon_1.jpg", "item": "Reveal in Finder"},
    {"expect": {"lastFileAction": "reveal: horizon_1.jpg", "focus": "horizon_1.jpg"}},

    {"log": "Rubber band from the gap above and left of one tile to the middle of another selects the tiles in the rectangle (5 columns here)."},
    {"band": ["sonoma_0.jpg", "sonoma_1 copy.jpg"]},
    {"wait": "idle"},
    {"snapshot": "01-rubber-band"},
    {"expect": {"selection": ["sonoma_0.jpg", "sonoma_0_blur1.5.jpg", "sonoma_0_under.jpg", "sonoma_1 copy.jpg"], "focus": "sonoma_0.jpg"}},
    {"key": "x"},
    {"expect": {"totals.rejected": 6}},

    {"log": "Open Recent > Clear Menu empties the recent list; the session and its decisions stay."},
    {"close": true},
    {"wait": "idle"},
    {"expect": {"screen": "welcome", "recents.count": 1}},
    {"menuItem": ["File", "Open Recent", "Clear Menu"]},
    {"wait": "idle"},
    {"snapshot": "02-welcome-after-clear"},
    {"expect": {"recents.count": 0}},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"sleep": 0.3},
    {"expect": {"totals.rejected": 6, "recents.count": 1}},
    {"quit": true}
  ]
}
