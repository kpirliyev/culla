{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Rescue on the screen: P keeps the focused reject and it leaves the list, ⌘Z puts it back, ⇧-selection rescues several; then apply moves only what is left."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"saveHash": "37-original"},
    {"group": "allPhotos"},
    {"click": "horizon_1.jpg"},
    {"key": "x"},
    {"click": "sonoma_3.jpg"},
    {"key": "x"},
    {"click": "horizon_0_under.jpg"},
    {"key": "x"},
    {"click": "horizon_2.jpg"},
    {"key": "x"},
    {"click": "horizon_3.jpg"},
    {"key": "x"},
    {"wait": "idle"},
    {"applyScreen": "open"},
    {"expect": {"apply.plan.rejected": 5, "apply.buttonTitle": "Move 5 Photos to _Rejected"}},
    {"applyFocus": "horizon_1.jpg"},
    {"key": "p"},
    {"wait": "idle"},
    {"snapshot": "01-rescued-one"},
    {"expect": {"apply.plan.rejected": 4, "apply.rescuedThisVisit": 1, "photo:horizon_1.jpg.decision": "kept", "apply.buttonTitle": "Move 4 Photos to _Rejected"}},
    {"key": "cmd+z"},
    {"expect": {"apply.plan.rejected": 5, "apply.focus": "horizon_1.jpg", "photo:horizon_1.jpg.decision": "rejected"}},
    {"applyFocus": "horizon_1.jpg"},
    {"key": "shift+right"},
    {"key": "p"},
    {"expect": {"apply.plan.rejected": 3, "apply.rescuedThisVisit": 2}},
    {"key": "escape"},
    {"expect": {"apply.screenOpen": false, "totals.kept": 2}},
    {"key": "cmd+return"},
    {"wait": "apply"},
    {"expect": {"apply.plan.rejected": 3}},
    {"key": "shift+cmd+return"},
    {"wait": "applied"},
    {"expect": {"apply.result.headline": "3 photos moved to _Rejected", "totals.photos": 32}},
    {"bannerAction": "undo"},
    {"expectHash": "37-original"},
    {"quit": true}
  ]
}
