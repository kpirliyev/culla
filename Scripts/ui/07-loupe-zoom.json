{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. Zoom in the loupe: fit, Z to 100%, panning, sticky zoom across a burst, 400%, back to fit."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"click": "sonoma_burst0.jpg"},
    {"key": "space"},
    {"wait": "idle"},
    {"snapshot": "01-fit"},
    {"dump": "01-fit", "photos": false},
    {"expect": {"viewMode": "loupe", "loupe.isFit": true, "loupe.visibleRect": [0, 0, 1, 1], "loupe.resolution": "screen",
                "loupe.fullImageInUse": false, "loupe.pixelSize": [3000, 2000]}},

    {"log": "Z: 100% on the middle, as the photo has no scores. A 3000-pixel photo needs its full-size image at 100%."},
    {"key": "z"},
    {"wait": "idle"},
    {"snapshot": "02-zoom-100"},
    {"dump": "02-zoom-100", "photos": false},
    {"expect": {"loupe.zoomPercent": 100, "loupe.isFit": false, "loupe.fullImageInUse": true, "loupe.resolution": "full",
                "loupe.magnificationFilter": "nearest"}},
    {"expect": {"loupe.visibleCentre": [0.5, 0.5], "loupe.zoomFactor": 1}, "tolerance": 0.002},

    {"log": "Pan to a spot, then step through the burst: the same spot at the same zoom on every frame."},
    {"pan": [0.62, 0.33]},
    {"wait": "idle"},
    {"expect": {"loupe.visibleCentre": [0.62, 0.33]}, "tolerance": 0.002},
    {"snapshot": "03-panned"},
    {"key": "right"},
    {"wait": "idle"},
    {"snapshot": "04-next-frame-same-spot"},
    {"dump": "04-next-frame", "photos": false},
    {"expect": {"focus": "sonoma_burst1.jpg", "loupe.zoomPercent": 100, "loupe.fullImageInUse": true}},
    {"expect": {"loupe.visibleCentre": [0.62, 0.33]}, "tolerance": 0.002},
    {"key": "right"},
    {"wait": "idle"},
    {"expect": {"focus": "sonoma_burst2.jpg", "loupe.zoomPercent": 100, "loupe.fullImageInUse": true}},
    {"expect": {"loupe.visibleCentre": [0.62, 0.33]}, "tolerance": 0.002},
    {"key": "left"},
    {"key": "left"},
    {"wait": "idle"},
    {"expect": {"focus": "sonoma_burst0.jpg", "loupe.zoomPercent": 100}},
    {"expect": {"loupe.visibleCentre": [0.62, 0.33]}, "tolerance": 0.002},

    {"log": "400% keeps the centre; zooming below fit lands on fit."},
    {"zoom": 4},
    {"wait": "idle"},
    {"snapshot": "05-zoom-400"},
    {"expect": {"loupe.zoomPercent": 400}},
    {"expect": {"loupe.visibleCentre": [0.62, 0.33]}, "tolerance": 0.002},
    {"zoom": 0.05},
    {"wait": "idle"},
    {"expect": {"loupe.isFit": true, "loupe.fullImageInUse": false, "loupe.fullImagesHeld": []}},

    {"log": "The mouse: a double click zooms to 100% keeping the clicked spot under the pointer; a drag pans; a double click again fits; the scroll wheel with Command and a pinch zoom."},
    {"loupeMouse": {"doubleClick": [0.45, 0.45]}},
    {"wait": "idle"},
    {"expect": {"loupe.zoomPercent": 100, "loupe.fullImageInUse": true}},
    {"expect": {"loupe.visibleCentre": [0.4775, 0.4775]}, "tolerance": 0.003},
    {"loupeMouse": {"drag": [[0.45, 0.45], [0.40, 0.42]]}},
    {"wait": "idle"},
    {"expect": {"loupe.visibleCentre": [0.5275, 0.5075]}, "tolerance": 0.003},
    {"loupeMouse": {"doubleClick": [0.5, 0.5]}},
    {"wait": "idle"},
    {"expect": {"loupe.isFit": true}},
    {"loupeMouse": {"scroll": 5, "at": [0.5, 0.5], "modifiers": "cmd"}},
    {"wait": "idle"},
    {"expect": {"loupe.isFit": false}},
    {"expect": {"loupe.visibleCentre": [0.5, 0.5]}, "tolerance": 0.003},
    {"dump": "06-scroll-zoom", "photos": false},
    {"loupeMouse": {"magnify": 2, "at": [0.5, 0.5]}},
    {"wait": "idle"},
    {"dump": "07-pinch", "photos": false},
    {"zoom": "fit"},
    {"wait": "idle"},

    {"log": "Z twice: 100% and back to fit. Leaving the loupe drops the zoom."},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"loupe.zoomPercent": 100}},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"loupe.isFit": true}},
    {"key": "z"},
    {"key": "space"},
    {"wait": "idle"},
    {"expect": {"viewMode": "grid", "loupe.fullImagesHeld": [], "loupe.active": false}},
    {"key": "space"},
    {"wait": "idle"},
    {"expect": {"viewMode": "loupe", "loupe.isFit": true}},
    {"dump": "final", "photos": false},
    {"quit": true}
  ]
}
