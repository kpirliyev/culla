{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "A read-only shoot (a locked card): Apply is unavailable and says why; Copy Keepers To copies kept and unreviewed photos elsewhere; undo removes the copies."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"group": "allPhotos"},
    {"click": "horizon_1.jpg"},
    {"key": "x"},
    {"click": "sonoma_3.jpg"},
    {"key": "x"},
    {"click": "horizon_0_under.jpg"},
    {"key": "x"},
    {"wait": "idle"},
    {"fixture": {"readOnly": true}},
    {"saveHash": "45-original"},
    {"applyScreen": "open"},
    {"snapshot": "01-read-only"},
    {"expect": {"apply.readOnly": true, "apply.plan.blocker": "readOnlyFolder", "apply.buttonTitle": "Copy Keepers To…"}},
    {"copyKeepersTo": "$SHOOT/../CullaCopyDest"},
    {"wait": "idle"},
    {"snapshot": "02-copy-plan"},
    {"dump": "02-copy-plan", "photos": false},
    {"key": "shift+cmd+return"},
    {"wait": "applied"},
    {"snapshot": "03-copied"},
    {"dump": "03-copied", "photos": false},
    {"expect": {"apply.result.state": "done", "totals.photos": 35}},
    {"expectHash": "45-original"},
    {"bannerAction": "undo"},
    {"snapshot": "04-copy-undone"},
    {"expect": {"apply.undoReport.state": "undone"}},
    {"fixture": {"readOnly": false}},
    {"quit": true}
  ]
}
