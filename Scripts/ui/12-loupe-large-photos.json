{
  "needs": {"reset": true, "shoot": "large"},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset --shoot <a folder made with Scripts/make_large_photos.py>. Times Z to a sharp 24 MP image and stepping at 100%, and checks the full-size image is let go."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"click": "burst_1.jpg"},
    {"key": "space"},
    {"wait": "idle"},
    {"snapshot": "01-fit"},
    {"expect": {"loupe.pixelSize": [6000, 4000], "loupe.isFit": true, "loupe.fullImageInUse": false}},
    {"sleep": 0.3},
    {"resetStalls": true},
    {"zoom": 1, "centre": [0.6, 0.4]},
    {"wait": "idle"},
    {"snapshot": "02-chart-at-100"},
    {"dump": "02-zoom", "photos": false},
    {"expect": {"loupe.zoomPercent": 100, "loupe.fullImageInUse": true, "loupe.imageSize": [6000, 4000],
                "loupe.magnificationFilter": "nearest"}},
    {"expect": {"loupe.visibleCentre": [0.6, 0.4]}, "tolerance": 0.002},
    {"key": "right"},
    {"wait": "idle"},
    {"snapshot": "03-next-frame-at-100"},
    {"dump": "03-step", "photos": false},
    {"expect": {"focus": "burst_2.jpg", "loupe.fullImageInUse": true}},
    {"expect": {"loupe.visibleCentre": [0.6, 0.4]}, "tolerance": 0.002},
    {"key": "right"},
    {"wait": "idle"},
    {"key": "right"},
    {"wait": "idle"},
    {"key": "right"},
    {"wait": "idle"},
    {"dump": "04-steps", "photos": false},
    {"expect": {"focus": "burst_5.jpg", "loupe.fullImageInUse": true}},
    {"zoom": 2.5, "centre": [0.59, 0.39]},
    {"wait": "idle"},
    {"snapshot": "05-chart-at-250"},
    {"key": "z"},
    {"wait": "idle"},
    {"dump": "06-fit", "photos": false},
    {"expect": {"loupe.isFit": true, "loupe.fullImagesHeld": [], "loupe.fullImageInUse": false}},
    {"quit": true}
  ]
}
