{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "First open of the sample: analysis starts by itself, the defect groups, stacks and duplicate sets fill in (the same as culla-eval reports: 5 stacks, 1 exact and 2 near-duplicate sets), badges appear on the tiles, and the summary banner offers Start Reviewing."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"expect": {"analysis.analysedThisOpen": 0, "analysis.cachedCount": 0}},
    {"snapshot": "01-opened-analysing"},
    {"dump": "01-opened", "photos": false},
    {"wait": "analysis", "timeout": 150},
    {"snapshot": "02-analysed-grid"},
    {"dump": "02-analysed"},
    {"expect": {
      "analysis.phase": "finished",
      "analysis.analysedThisOpen": 34,
      "analysis.done": 34,
      "analysis.statusText": "Analysed",
      "stackCount": 5,
      "exactDuplicateSets": 1,
      "nearDuplicateSets": 2,
      "groups.blurry.total": 18,
      "groups.exposure.total": 2,
      "flagCounts.lowAesthetics": 17,
      "flagCounts.clippedHighlights": 1,
      "flagCounts.clippedShadows": 1,
      "flagCounts.blurry": 18,
      "groups.eyesClosed.total": 0,
      "groups.similarStacks.total": 14,
      "groups.duplicates.total": 6,
      "photo:sonoma_0_over.jpg.tiers.blurry": "certain",
      "photo:sonoma_0_over.jpg.tiers.clippedHighlights": "likely",
      "photo:sonoma_0_over.jpg.tiers.lowAesthetics": "likely",
      "photo:horizon_0_under.jpg.tiers.clippedShadows": "likely",
      "photo:horizon_0_under.jpg.tiers.lowAesthetics": "likely",
      "photo:sonoma_0_blur6.jpg.tiers.blurry": "certain",
      "photo:sonoma_0.jpg.tiers.blurry": "likely",
      "duplicateSets.0.kind": "exact",
      "duplicateSets.0.members": ["sonoma_1 copy.jpg", "sonoma_1.jpg"],
      "totals.left": 34,
      "focus": "sub/Big Sur Coastline.jpg",
      "viewMode": "grid"
    }},

    {"log": "Other Issues and the banner's reject count include Vision's lens smudge flag, whose reading for horizon_0_under and sonoma_0_over has moved across the 0.5 threshold between Vision model versions: they are checked by pattern and by the flags far from any threshold, not by exact totals."},
    {"expectMatch": {"summaryBanner": "^35 photos · 5 stacks · \\d+ likely rejects$", "groups.otherIssues.total": "^(17|18|19)$"}},
    {"log": "Badges at the smallest thumbnail size."},
    {"settings": {"thumbnailSize": 80}},
    {"wait": "idle"},
    {"snapshot": "03-badges-smallest"},
    {"settings": {"thumbnailSize": 168}},

    {"log": "The inspector's Flags section on a photo with a Certain flag."},
    {"click": "sonoma_0_over.jpg"},
    {"key": "i"},
    {"wait": "idle"},
    {"snapshot": "04-inspector-flags"},
    {"key": "i"},

    {"log": "Start Reviewing opens the first group with photos left, in the recommended order: Duplicates, in duplicate review on the first set's copy to keep."},
    {"key": "shift+cmd+r"},
    {"wait": "idle"},
    {"expect": {"currentGroup": "duplicates", "viewMode": "duplicateReview", "focus": "sonoma_1.jpg", "summaryBanner": null}},
    {"snapshot": "05-start-reviewing"},
    {"quit": true}
  ]
}
