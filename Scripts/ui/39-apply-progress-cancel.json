{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Progress while applying, then Escape cancels between files; what ran is reported and undone."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"saveHash": "39-original"},
    {"group": "allPhotos"},
    {"click": "horizon_1.jpg"},
    {"key": "x"},
    {"click": "sonoma_3.jpg"},
    {"key": "x"},
    {"click": "horizon_0_under.jpg"},
    {"key": "x"},
    {"click": "horizon_2.jpg"},
    {"key": "x"},
    {"click": "horizon_3.jpg"},
    {"key": "x"},
    {"wait": "idle"},
    {"applyScreen": "open"},
    {"fault": {"holdAt": 4}},
    {"key": "shift+cmd+return"},
    {"wait": "held"},
    {"snapshot": "01-progress"},
    {"dump": "01-progress", "photos": false},
    {"expect": {"apply.run.kind": "apply", "apply.run.done": 4}},
    {"log": "While it runs nothing changes decisions: P is unavailable."},
    {"command": "keep", "allowUnavailable": true},
    {"key": "escape"},
    {"expect": {"apply.run.cancelling": true}},
    {"releaseHold": true},
    {"wait": "applied"},
    {"snapshot": "02-cancelled"},
    {"expect": {"apply.result.state": "cancelled"}},
    {"bannerAction": "undo"},
    {"expectHash": "39-original"},
    {"quit": true}
  ]
}
