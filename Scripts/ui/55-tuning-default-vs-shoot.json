{
  "needs": {"reset": true},
  "timeout": 300,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. The tuning panel changes only the open shoot, which keeps its own tuning with its session across a reopen; another shoot follows the default. Save as Default makes the shoot's tuning the default; Reset to Default puts the shoot back on it. Settings shows the default and says when the open shoot has its own."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"group": "blurry"},
    {"wait": "idle"},
    {"popover": "tuning"},
    {"expect": {"tuningPanel.hasOwnTuning": false, "tuningScope.hasOwnTuning": false}},
    {"snapshot": "01-panel-follows-default"},
    {"tuning": {"blurryBelow": 15}},
    {"expect": {"tuning.blurryBelow": 15, "tuningDefault.blurryBelow": 25, "tuningScope.hasOwnTuning": true,
                "tuningScope.differsFromDefault": ["blurryBelow"], "tuningPanel.hasOwnTuning": true, "groups.blurry.total": 6}},
    {"snapshot": "02-panel-own-tuning"},
    {"popover": "close"},

    {"log": "Settings shows the default, says the shoot has its own, and counts what the default would flag in it."},
    {"settingsWindow": "blur"},
    {"expect": {"settingsWindow.scopeNote": "“CullaSampleShoot” has its own settings from its Adjust panel, so changes here apply to other shoots. Counts show what these would flag in it.",
                "settingsWindow.lines.blurryBelow": "Blurry: 18 photos"}},
    {"snapshot": "03-settings-shoot-has-own", "window": "settings"},
    {"settings": {"default": {"blurryCertainBelow": 10}}},
    {"expect": {"tuningDefault.blurryCertainBelow": 10, "tuning.blurryCertainBelow": 15, "groups.blurry.total": 6}},
    {"settings": {"default": {"blurryCertainBelow": 15}}},
    {"settingsWindow": "close"},

    {"log": "Another shoot follows the default; reopening this one brings its own tuning back."},
    {"close": true},
    {"open": "$SHOOT/../Empty"},
    {"expect": {"tuning.blurryBelow": 25, "tuningScope.hasOwnTuning": false}},
    {"close": true},
    {"openRecent": "CullaSampleShoot"},
    {"wait": "analysis", "timeout": 60},
    {"expect": {"tuning.blurryBelow": 15, "tuningScope.hasOwnTuning": true, "groups.blurry.total": 6, "tuningDefault.blurryBelow": 25}},

    {"log": "Save as Default: the default takes the shoot's value, and the shoot follows the default again."},
    {"group": "blurry"},
    {"popover": "tuning"},
    {"tuningAction": "saveAsDefault"},
    {"expect": {"tuningDefault.blurryBelow": 15, "tuning.blurryBelow": 15, "tuningScope.hasOwnTuning": false, "tuningPanel.hasOwnTuning": false}},
    {"snapshot": "04-saved-as-default"},
    {"popover": "close"},
    {"settings": {"default": {"blurryBelow": 20}}},
    {"expect": {"tuning.blurryBelow": 20, "tuningScope.hasOwnTuning": false}},

    {"log": "Reset to Default after a change for this shoot."},
    {"tuning": {"blurryBelow": 30}},
    {"expect": {"tuning.blurryBelow": 30, "tuningScope.hasOwnTuning": true}},
    {"tuningAction": "resetToDefault"},
    {"expect": {"tuning.blurryBelow": 20, "tuningScope.hasOwnTuning": false}},

    {"log": "Leave the shoot with its own value, for 56 to find after a relaunch."},
    {"tuning": {"blurryBelow": 30}},
    {"wait": "idle"},
    {"quit": true}
  ]
}
