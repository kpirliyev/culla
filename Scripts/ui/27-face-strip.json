{
  "needs": {"reset": true},
  "timeout": 200,
  "window": [1280, 800],
  "steps": [
    {"log": "Injected faces in the Sonoma burst: two people at nearly the same places, the second blinking in frame 3 and the first missing from frame 4. The face strip shows a row per person and a column per frame, the blink outlined; the pick avoids the blinking frame although it is the sharpest."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"injectScores": "burst", "frames": ["sonoma_burst0.jpg", "sonoma_burst1.jpg", "sonoma_burst2.jpg", "sonoma_burst3.jpg"],
     "people": [{"box": [0.30, 0.30, 0.09, 0.12]}, {"box": [0.56, 0.33, 0.08, 0.11]}],
     "blink": [[2, 1]], "missing": [[3, 0]], "sharpness": [52, 64, 70, 58]},
    {"group": "similarStacks"},
    {"keys": ["down", "down"]},
    {"wait": "idle"},
    {"expect": {
      "stackReview.stackIndex": 2, "stackReview.pick": "sonoma_burst1.jpg", "stackReview.current": "sonoma_burst0.jpg",
      "stackReview.pickReason": "sharpest frame with all eyes open",
      "stackReview.currentNotes": ["softer than the pick"],
      "faceStrip.rows": 2, "faceStrip.byPosition": false, "faceStrip.rowLabels": ["Person 1", "Person 2"],
      "faceStrip.filled": [[true, true, true, false], [true, true, true, true]],
      "faceStrip.outlined": [[false, false, false, false], [false, false, true, false]],
      "faceStrip.currentColumn": 0, "faceStrip.pickColumn": 1, "faceStrip.crops": 7, "faceStrip.cropsShown": 7
    }},
    {"snapshot": "01-face-strip-fitted"},
    {"dump": "01-face-strip", "photos": false},

    {"log": "The blinking frame and the frame missing a face say so."},
    {"keys": ["right", "right"]},
    {"wait": "idle"},
    {"expect": {"stackReview.current": "sonoma_burst2.jpg", "stackReview.currentNotes": ["eyes closed"], "faceStrip.currentColumn": 2}},
    {"snapshot": "02-blinking-frame"},
    {"key": "right"},
    {"wait": "idle"},
    {"expect": {"stackReview.currentNotes": ["softer than the pick", "a face is missing"]}},

    {"log": "A click on a cell: that frame becomes current and both panes zoom to that face at 100%."},
    {"faceCell": [1, 2]},
    {"wait": "idle"},
    {"expect": {"stackReview.current": "sonoma_burst2.jpg", "stackReview.faceRow": 1, "stackReview.currentPane.zoomPercent": 100,
                "stackReview.pickPane.zoomPercent": 100, "stackReview.currentPane.resolution": "full", "stackReview.pickPane.resolution": "full"}},
    {"snapshot": "03-zoomed-to-blink"},
    {"dump": "03-zoomed", "photos": false},
    {"log": "Tab moves both panes to the other person; Z goes back to fit."},
    {"key": "tab"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceRow": 0}},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"stackReview.currentPane.isFit": true, "stackReview.pickPane.isFit": true}},

    {"log": "F hides and shows the strip."},
    {"key": "f"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceStripShown": false}},
    {"snapshot": "04-strip-hidden"},
    {"key": "f"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceStripShown": true}},

    {"log": "In the loupe, a photo in no stack shows its own faces in one row with F."},
    {"injectScores": {"sonoma_2.jpg": {"faces": [
      {"box": [0.2, 0.3, 0.1, 0.14], "eyes": [0.8, 0.8]}, {"box": [0.45, 0.32, 0.09, 0.13], "eyes": [0.1, 0.1]}, {"box": [0.7, 0.3, 0.08, 0.12], "eyes": [0.7, 0.7]}
    ]}}},
    {"group": "allPhotos"},
    {"click": "sonoma_2.jpg", "count": 2},
    {"wait": "idle"},
    {"key": "f"},
    {"wait": "idle"},
    {"expect": {"viewMode": "loupe", "faceStrip.rows": 1, "faceStrip.columns": ["sonoma_2.jpg", "sonoma_2.jpg", "sonoma_2.jpg"],
                "faceStrip.outlined": [[false, true, false]]}},
    {"snapshot": "05-loupe-single-photo-strip"},
    {"faceCell": [0, 1]},
    {"wait": "idle"},
    {"expect": {"loupe.zoomPercent": 100, "loupe.targetedFace": 1}},
    {"quit": true}
  ]
}
