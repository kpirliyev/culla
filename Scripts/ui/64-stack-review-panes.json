{
  "needs": {"reset": true},
  "timeout": 220,
  "window": [1280, 800],
  "steps": [
    {"log": "Stack review's space: F hides the faces, the face strip and the boxes over both panes, and the frames grow into the strip's height; H hides the best pick and the current frame fills the row. H is a setting (Settings ▸ General), not a decision: it stays out of the undo history, and Return still keeps the pick and rejects the rest."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"injectScores": "burst", "frames": ["sonoma_burst0.jpg", "sonoma_burst1.jpg", "sonoma_burst2.jpg", "sonoma_burst3.jpg"],
     "people": [{"box": [0.30, 0.30, 0.09, 0.12]}, {"box": [0.56, 0.33, 0.08, 0.11]}],
     "blink": [[2, 1]], "missing": [[3, 0]], "sharpness": [52, 64, 70, 58]},
    {"group": "similarStacks"},
    {"keys": ["down", "down"]},
    {"wait": "idle"},
    {"expect": {
      "stackReview.stackIndex": 2, "stackReview.pick": "sonoma_burst1.jpg", "stackReview.current": "sonoma_burst0.jpg",
      "stackReview.rightPane": "sonoma_burst1.jpg", "settings.showsBestPickPane": true, "menuKeys.toggleBestPickPane": "H",
      "stackReview.hints": "↩ accept · P keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F hide faces · H hide pick",
      "stackReview.pickPaneShown": true, "stackReview.currentPaneFillsRow": false, "stackReview.pickPane.photo": "sonoma_burst1.jpg",
      "stackReview.faceStripShown": true, "stackReview.faceStripSeparatorHeight": 1, "stackReview.spaceAccounted": true,
      "stackReview.faceStripHeight": 174, "stackReview.panesHeight": 396, "stackReview.currentPaneSize": [529, 396],
      "stackReview.currentPane.isFit": true, "stackReview.pickPane.isFit": true,
      "stackReview.faceStripWanted": true, "stackReview.faceBoxesShown": true, "stackReview.faceBoxesEnabled": true,
      "stackReview.currentPaneFaceBoxes": 2, "stackReview.pickPaneFaceBoxes": 2
    }},
    {"snapshot": "01-two-panes-with-strip"},
    {"dump": "01-two-panes-with-strip", "photos": false},

    {"log": "F: the faces go. The strip and its separator take no height; the panes are taller by exactly that, and still fitted. Neither pane draws face boxes, and the hint says F shows them again."},
    {"key": "f"},
    {"wait": "idle"},
    {"expect": {
      "stackReview.hints": "↩ accept · P keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F show faces · H hide pick",
      "stackReview.faceBoxesShown": false, "stackReview.currentPaneFaceBoxes": 0, "stackReview.pickPaneFaceBoxes": 0,
      "stackReview.currentPane.faceBoxes": 0, "stackReview.pickPane.faceBoxes": 0, "stackReview.faceBoxesEnabled": false,
      "stackReview.faceStripShown": false, "stackReview.faceStripWanted": false, "stackReview.faceStripHeight": 0,
      "stackReview.faceStripSeparatorHeight": 0, "stackReview.spaceAccounted": true, "stackReview.pickPaneShown": true,
      "stackReview.panesHeight": 571, "stackReview.currentPaneSize": [529, 571], "stackReview.pickPaneSize": [529, 571],
      "stackReview.currentPane.isFit": true, "stackReview.pickPane.isFit": true,
      "stackReview.currentPane.resolution": "screen", "stackReview.pickPane.resolution": "screen"
    }},
    {"snapshot": "02-strip-hidden"},
    {"dump": "02-strip-hidden", "photos": false},
    {"log": "With the faces hidden, B (face boxes) is disabled: it changes nothing, so F brings the boxes back as they were."},
    {"key": "b"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceBoxesShown": false, "stackReview.currentPaneFaceBoxes": 0, "stackReview.pickPaneFaceBoxes": 0,
                "stackReview.faceBoxesEnabled": false}},
    {"key": "f"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceStripShown": true, "stackReview.faceStripSeparatorHeight": 1, "stackReview.spaceAccounted": true,
                "stackReview.panesHeight": 396, "stackReview.faceStripHeight": 174,
                "stackReview.hints": "↩ accept · P keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F hide faces · H hide pick",
                "stackReview.faceBoxesShown": true, "stackReview.faceBoxesEnabled": true,
                "stackReview.currentPaneFaceBoxes": 2, "stackReview.pickPaneFaceBoxes": 2}},
    {"log": "With the faces shown, B still switches the boxes off and on, and the strip stays."},
    {"key": "b"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceBoxesShown": false, "stackReview.currentPaneFaceBoxes": 0, "stackReview.pickPaneFaceBoxes": 0,
                "stackReview.faceStripShown": true, "stackReview.faceBoxesEnabled": true,
                "stackReview.hints": "↩ accept · P keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F hide faces · H hide pick"}},
    {"key": "b"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceBoxesShown": true, "stackReview.currentPaneFaceBoxes": 2, "stackReview.pickPaneFaceBoxes": 2}},

    {"log": "H: the best pick's pane goes and lets its image go; the current frame fills the row, fitted to it. Nothing enters the undo history."},
    {"key": "h"},
    {"wait": "idle"},
    {"expect": {
      "settings.showsBestPickPane": false, "stackReview.pickPaneShown": false, "stackReview.pickPaneSize": [0, 0],
      "stackReview.hints": "↩ accept · P keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F hide faces · H show pick",
      "stackReview.pickPane.photo": null, "stackReview.currentPaneFillsRow": true, "stackReview.spaceAccounted": true,
      "stackReview.currentPaneSize": [1059, 396], "stackReview.current": "sonoma_burst0.jpg", "stackReview.currentPane.isFit": true, "stackReview.currentPane.resolution": "screen",
      "stackReview.faceStripShown": true, "canUndo": false
    }},
    {"snapshot": "03-pick-pane-hidden"},
    {"dump": "03-pick-pane-hidden", "photos": false},

    {"log": "On the pick itself, alone on screen, the caption says it is the pick and why."},
    {"key": "right"},
    {"wait": "idle"},
    {"expect": {"stackReview.current": "sonoma_burst1.jpg", "stackReview.pickPaneShown": false, "stackReview.pickPane.photo": null}},
    {"snapshot": "04-pick-alone"},
    {"key": "left"},

    {"log": "Both hidden: the single frame takes the strip's height too."},
    {"key": "f"},
    {"wait": "idle"},
    {"expect": {"stackReview.faceStripHeight": 0, "stackReview.currentPaneFillsRow": true, "stackReview.spaceAccounted": true,
                "stackReview.currentPaneSize": [1059, 571], "stackReview.currentPane.isFit": true,
                "stackReview.currentPaneFaceBoxes": 0, "stackReview.pickPaneFaceBoxes": 0}},
    {"dump": "05-single-pane-no-strip", "photos": false},
    {"snapshot": "05-single-pane-no-strip"},
    {"key": "f"},
    {"wait": "idle"},

    {"log": "Z zooms the single pane to 100% and back."},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"stackReview.currentPane.zoomPercent": 100, "stackReview.currentPane.resolution": "full", "stackReview.pickPane.photo": null}},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"stackReview.currentPane.isFit": true}},

    {"log": "Return still keeps the pick and rejects the rest, then opens the next stack with one pane."},
    {"key": "return"},
    {"wait": "idle"},
    {"expect": {
      "photo:sonoma_burst1.jpg.decision": "kept", "photo:sonoma_burst0.jpg.decision": "rejected",
      "photo:sonoma_burst2.jpg.decision": "rejected", "photo:sonoma_burst3.jpg.decision": "rejected",
      "undoTitle": "Undo Accept Stack", "stackReview.stackIndex": 3, "stackReview.pickPaneShown": false,
      "stackReview.currentPaneFillsRow": true
    }},
    {"snapshot": "06-next-stack-one-pane"},

    {"log": "The setting, as Settings ▸ General changes it, brings the pick back at once; so does H, and the View menu names the state."},
    {"settings": {"showsBestPickPane": true}},
    {"wait": "idle"},
    {"expect": {"stackReview.pickPaneShown": true, "stackReview.currentPaneFillsRow": false, "stackReview.spaceAccounted": true,
                "stackReview.pickPane.isFit": true}},
    {"menuItem": ["View", "Hide Best Pick Pane"]},
    {"wait": "idle"},
    {"expect": {"settings.showsBestPickPane": false, "stackReview.pickPaneShown": false}},
    {"key": "h"},
    {"wait": "idle"},
    {"expect": {"settings.showsBestPickPane": true, "stackReview.pickPaneShown": true, "stackReview.currentPaneFillsRow": false,
                "undoTitle": "Undo Accept Stack"}},
    {"expectMatch": {"stackReview.pickPane.photo": "\\.jpg$"}},
    {"snapshot": "07-pick-pane-back"},
    {"dump": "07-pick-pane-back", "photos": false},

    {"log": "Keys shown to the person follow the live key map: the header hint and the Settings note name a remapped key."},
    {"settingsWindow": "keys"},
    {"bindKey": "toggleBestPickPane", "chord": "shift+h"},
    {"bindKey": "keep", "chord": "k"},
    {"expect": {"keyMap.toggleBestPickPane": ["shift+h"], "menuKeys.toggleBestPickPane": "⇧H", "keyConflicts": [],
                "stackReview.hints": "↩ accept · K keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F hide faces · ⇧H hide pick"}},
    {"key": "shift+h"},
    {"wait": "idle"},
    {"expect": {"stackReview.pickPaneShown": false, "stackReview.hints": "↩ accept · K keep · X reject · ←→ frame · ↓ skip · ⇧S pick · F hide faces · ⇧H show pick"}},
    {"snapshot": "08-remapped-hint"},
    {"key": "shift+h"},
    {"wait": "idle"},
    {"expect": {"stackReview.pickPaneShown": true}},
    {"snapshot": "09-remapped-hint-two-panes"},
    {"log": "Settings ▸ General lists the setting, with the remapped keys in its notes."},
    {"settingsWindow": "general"},
    {"snapshot": "10-settings-general", "window": "settings"},
    {"settingsWindow": "close"},
    {"quit": true}
  ]
}
