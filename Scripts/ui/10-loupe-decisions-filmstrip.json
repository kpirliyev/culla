{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. Decisions, ratings, undo and redo in the loupe; the filmstrip shows them, follows the focus and takes clicks and the context menu."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"click": "sonoma_1.jpg"},
    {"key": "space"},
    {"wait": "idle"},
    {"expect": {"viewMode": "loupe", "focus": "sonoma_1.jpg"}},

    {"log": "P keeps and advances, X rejects and advances, a rating stays, U clears."},
    {"key": "p"},
    {"expect": {"photo:sonoma_1.jpg.decision": "kept", "focus": "sonoma_2.jpg", "undoTitle": "Undo Keep"}},
    {"key": "x"},
    {"expect": {"photo:sonoma_2.jpg.decision": "rejected", "focus": "sonoma_3.jpg"}},
    {"key": "4"},
    {"expect": {"photo:sonoma_3.jpg.rating": 4, "focus": "sonoma_3.jpg"}},
    {"key": "left"},
    {"wait": "idle"},
    {"snapshot": "01-rejected-photo-marked"},
    {"expect": {"focus": "sonoma_2.jpg"}},
    {"key": "u"},
    {"expect": {"photo:sonoma_2.jpg.decision": "unreviewed", "focus": "sonoma_3.jpg"}},
    {"key": "cmd+z"},
    {"expect": {"photo:sonoma_2.jpg.decision": "rejected", "focus": "sonoma_2.jpg", "redoTitle": "Redo Clear Decision"}},
    {"key": "shift+cmd+z"},
    {"expect": {"photo:sonoma_2.jpg.decision": "unreviewed"}},
    {"key": "cmd+z"},
    {"key": "right"},
    {"key": "right"},
    {"key": "right"},
    {"key": "x"},
    {"key": "x"},
    {"key": "p"},
    {"key": "left"},
    {"key": "left"},
    {"wait": "idle"},
    {"snapshot": "02-filmstrip-with-decisions"},
    {"dump": "02-filmstrip", "photos": false},

    {"log": "A click in the filmstrip focuses that photo; the strip keeps the focus in the middle."},
    {"click": "horizon_1.jpg", "in": "filmstrip"},
    {"wait": "idle"},
    {"expect": {"focus": "horizon_1.jpg", "viewMode": "loupe"}},
    {"snapshot": "03-filmstrip-click"},
    {"dump": "03-filmstrip", "photos": false},

    {"log": "The filmstrip's context menu acts on the clicked photo."},
    {"contextMenu": "horizon_3.jpg", "in": "filmstrip", "item": "Reject"},
    {"expect": {"photo:horizon_3.jpg.decision": "rejected", "focus": "horizon_4.jpg"}},
    {"contextMenu": "horizon_3.jpg", "in": "filmstrip", "item": "3 Stars"},
    {"expect": {"photo:horizon_3.jpg.rating": 3}},

    {"log": "In Unreviewed a decision takes the photo out of the group and the next one shows."},
    {"group": "unreviewed"},
    {"key": "home"},
    {"wait": "idle"},
    {"expect": {"focus": "sub/Big Sur Coastline.jpg"}},
    {"key": "p"},
    {"wait": "idle"},
    {"expect": {"focus": "sub/Big Sur Horizon.jpg", "photo:sub/Big Sur Coastline.jpg.decision": "kept"}},
    {"snapshot": "04-unreviewed-after-keep"},
    {"dump": "final"},
    {"quit": true}
  ]
}
