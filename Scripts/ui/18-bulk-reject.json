{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. ⇧X in Blurry asks once, stating the count and the group, rejects every undecided Certain photo as one undo step; Likely photos are untouched. Elsewhere it says why there is nothing to reject."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"group": "blurry"},
    {"wait": "idle"},
    {"key": "x"},
    {"expect": {"photo:sonoma_0.jpg.decision": "rejected", "certainLeft": 6}},
    {"key": "shift+x"},
    {"wait": "confirmation"},
    {"snapshot": "01-confirmation"},
    {"expect": {"confirmation": "Reject 6 photos that are certainly blurry?"}},
    {"confirm": "cancel"},
    {"expect": {"totals.rejected": 1, "confirmation": null, "certainLeft": 6}},
    {"key": "shift+x"},
    {"confirm": true, "question": "Reject 6 photos that are certainly blurry?"},
    {"wait": "idle"},
    {"snapshot": "02-rejected"},
    {"expect": {"totals.rejected": 7, "certainLeft": 0, "undoTitle": "Undo Reject 6 Photos", "groups.blurry.left": 11,
                "photo:sonoma_0_blur6.jpg.decision": "rejected", "photo:horizon_0_blur6.jpg.decision": "rejected",
                "photo:horizon_0_blur3.jpg.decision": "unreviewed"}},
    {"key": "cmd+z"},
    {"expect": {"totals.rejected": 1, "certainLeft": 6, "photo:sonoma_0_blur6.jpg.decision": "unreviewed"}},
    {"key": "shift+cmd+z"},
    {"expect": {"totals.rejected": 7}},
    {"log": "Nothing left: it says so instead of asking."},
    {"key": "shift+x"},
    {"wait": "idle"},
    {"expect": {"confirmation": null, "notice": "No undecided photos left that are certainly blurry."}},
    {"snapshot": "03-none-left"},
    {"group": "exposure"},
    {"wait": "idle"},
    {"key": "shift+x"},
    {"expect": {"confirmation": null, "notice": "Nothing in Exposure is flagged Certain; its flags are always Likely, so review them one by one."}},
    {"log": "Outside defect groups ⇧X is not available."},
    {"group": "allPhotos"},
    {"key": "shift+x"},
    {"expect": {"confirmation": null, "totals.rejected": 7}},
    {"quit": true}
  ]
}
