{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. The preset control sets every detection slider at once: Lenient flags fewer photos, Strict more; moving one slider by hand shows Custom; Balanced is exactly the defaults."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"settingsWindow": "exposure"},
    {"expect": {"preset": "balanced", "settingsWindow.preset": "balanced", "groups.exposure.total": 2, "flagCounts.blurry": 18}},
    {"snapshot": "01-balanced", "window": "settings"},
    {"preset": "lenient"},
    {"wait": "grouping", "timeout": 30},
    {"expect": {"preset": "lenient", "tuningDefault.blurryBelow": 19, "tuningDefault.clippedShadowsAbove": 0.6, "tuning.clippedShadowsAbove": 0.6,
                "groups.exposure.total": 1, "flagCounts.clippedShadows": 0, "settingsWindow.lines.clippedShadowsAbove": "Crushed shadows: 1 → 0 photos"}},
    {"snapshot": "02-lenient", "window": "settings"},
    {"dump": "02-lenient", "photos": false},
    {"preset": "strict"},
    {"wait": "grouping", "timeout": 30},
    {"expect": {"preset": "strict", "tuningDefault.blurryBelow": 39, "tuningDefault.clippedHighlightsAbove": 0.24,
                "flagCounts.blurry": 20, "groups.exposure.total": 2}},
    {"snapshot": "03-strict", "window": "settings"},
    {"dump": "03-strict", "photos": false},
    {"log": "One slider moved by hand: Custom."},
    {"settings": {"default": {"clippedHighlightsAbove": 0.5}}},
    {"expect": {"preset": "custom", "settingsWindow.preset": "custom"}},
    {"snapshot": "04-custom", "window": "settings"},
    {"preset": "balanced"},
    {"wait": "grouping", "timeout": 30},
    {"expect": {"preset": "balanced", "tuningScope.differsFromDefault": [], "tuningDefault.blurryBelow": 25, "tuningDefault.clippedHighlightsAbove": 0.3,
                "flagCounts.blurry": 18, "groups.exposure.total": 2, "stackCount": 5, "nearDuplicateSets": 2, "analysis.analysedThisOpen": 34}},
    {"snapshot": "05-balanced-again", "window": "settings"},
    {"settingsWindow": "close"},
    {"quit": true}
  ]
}
