{
  "needs": {"reset": true},
  "timeout": 200,
  "window": [1280, 800],
  "steps": [
    {"log": "C compares the selected photos side by side; ← → move the focus; P, X, U and ratings act on the focused pane; Z zooms them all; Escape goes back with the selection as it was."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"key": "s"},
    {"click": "sonoma_2.jpg"},
    {"click": "sonoma_3.jpg", "modifiers": "cmd"},
    {"key": "c"},
    {"wait": "idle"},
    {"expect": {"viewMode": "compare", "compare.photos": ["sonoma_2.jpg", "sonoma_3.jpg"], "compare.focusedPane": 1, "compare.focused": "sonoma_3.jpg"}},
    {"snapshot": "01-compare-two"},
    {"key": "left"},
    {"key": "x"},
    {"expect": {"compare.focusedPane": 0, "photo:sonoma_2.jpg.decision": "rejected", "photo:sonoma_3.jpg.decision": "unreviewed"}},
    {"comparePane": 1},
    {"keys": ["p", "4"]},
    {"expect": {"compare.focusedPane": 1, "photo:sonoma_3.jpg.decision": "kept", "photo:sonoma_3.jpg.rating": 4}},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"compare.panes.0.zoomPercent": 100, "compare.panes.1.zoomPercent": 100}},
    {"snapshot": "02-compare-zoomed"},
    {"key": "escape"},
    {"wait": "idle"},
    {"expect": {"viewMode": "grid", "selection": ["sonoma_2.jpg", "sonoma_3.jpg"]}},

    {"log": "Four photos."},
    {"click": "sonoma_2.jpg"},
    {"click": "sonoma_4.jpg", "modifiers": "cmd"},
    {"click": "horizon_1.jpg", "modifiers": "cmd"},
    {"click": "horizon_3.jpg", "modifiers": "cmd"},
    {"key": "c"},
    {"wait": "idle"},
    {"expect": {"compare.photos.count": 4}},
    {"snapshot": "03-compare-four"},
    {"key": "c"},
    {"wait": "idle"},
    {"expect": {"viewMode": "grid"}},

    {"log": "From stack review, C compares the current frame with the pick, and Escape comes back to stack review."},
    {"key": "s"},
    {"group": "similarStacks"},
    {"keys": ["down", "down"]},
    {"wait": "idle"},
    {"key": "c"},
    {"wait": "idle"},
    {"expect": {"compare.photos": ["sonoma_burst0.jpg", "sonoma_burst1.jpg"], "compare.origin": "stackReview"}},
    {"key": "escape"},
    {"wait": "idle"},
    {"expect": {"viewMode": "stackReview", "stackReview.current": "sonoma_burst0.jpg"}},
    {"quit": true}
  ]
}
