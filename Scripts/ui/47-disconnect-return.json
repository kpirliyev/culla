{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "The shoot disconnects while analysis runs (its folder made unreadable, as a pulled card): analysis pauses, tiles dim, one line says what happened, Apply is unavailable, decisions stay; when it returns everything resumes."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"click": "sonoma_2.jpg"},
    {"key": "x"},
    {"fixture": {"disconnect": true}},
    {"wait": "disconnected", "timeout": 10},
    {"snapshot": "01-disconnected"},
    {"dump": "01-disconnected", "photos": false},
    {"expect": {"disk.disconnected": true, "totals.rejected": 1}},
    {"command": "reviewAndApply", "allowUnavailable": true},
    {"expect": {"apply.screenOpen": false}},
    {"fixture": {"disconnect": false}},
    {"wait": "reconnected", "timeout": 10},
    {"wait": "analysis", "timeout": 150},
    {"snapshot": "02-back"},
    {"expect": {"disk.disconnected": false, "totals.rejected": 1, "totals.unreadable": 1, "analysis.phase": "finished"}},
    {"log": "Tiles that must read their photos while the folder is gone stay as placeholders, are not marked unreadable, and fill in when it returns."},
    {"cache": "clearWithMemory"},
    {"fixture": {"disconnect": true}},
    {"wait": "disconnected", "timeout": 10},
    {"group": "unreviewed"},
    {"wait": "idle", "timeout": 20},
    {"expect": {"disk.disconnected": true, "totals.unreadable": 1}},
    {"expectMatch": {"thumbnailsAwaitingFolder": "^[1-9][0-9]*$"}},
    {"snapshot": "03-disconnected-new-tiles"},
    {"fixture": {"disconnect": false}},
    {"wait": "reconnected", "timeout": 10},
    {"wait": "idle", "timeout": 20},
    {"expect": {"disk.disconnected": false, "totals.unreadable": 1, "thumbnailsAwaitingFolder": 0}},
    {"expectMatch": {"viewMode": "^loupe$", "loupe.resolution": "^(screen|full)$"}},
    {"snapshot": "04-tiles-filled-in"},
    {"quit": true}
  ]
}
