{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. Every pane of the Settings window, first with no shoot open (detection panes say how to see counts), then with the analysed sample open (live counts beside each control)."},
    {"settingsWindow": "general", "viaKey": true},
    {"expect": {"settingsWindow.shown": true, "settingsWindow.pane": "general", "settingsWindow.title": "General",
                "settings.rejectAction": "moveToRejectedFolder", "settings.writeSidecars": true, "settings.advanceAfterDecision": true,
                "settings.includeSubfolders": true, "settings.collapseStacksInAllPhotos": true, "settings.cacheLimitGB": 5,
                "settings.sidecarMapping.rejectedRating": -1, "settings.sidecarMapping.keptLabel": "Green", "preset": "balanced"}},
    {"snapshot": "01-general", "window": "settings"},
    {"settingsWindow": "eyes"},
    {"expect": {"settingsWindow.scopeNote": "Open a shoot to see how many of its photos each setting flags.",
                "settingsWindow.lines.eyesClosedBelow": null, "settingsWindow.preset": "balanced"}},
    {"snapshot": "02-eyes-no-shoot", "window": "settings"},
    {"settingsWindow": "blur"},
    {"snapshot": "03-blur-no-shoot", "window": "settings"},
    {"settingsWindow": "similarity"},
    {"snapshot": "04-similarity-no-shoot", "window": "settings"},
    {"settingsWindow": "duplicates"},
    {"snapshot": "05-duplicates-no-shoot", "window": "settings"},
    {"settingsWindow": "exposure"},
    {"snapshot": "06-exposure-no-shoot", "window": "settings"},
    {"settingsWindow": "other"},
    {"snapshot": "07-other-no-shoot", "window": "settings"},
    {"settingsWindow": "performance"},
    {"expect": {"settingsWindow.pane": "performance", "cache.limitBytes": 5000000000}},
    {"snapshot": "08-performance", "window": "settings"},
    {"dump": "08-performance", "photos": false},
    {"settingsWindow": "keys"},
    {"expect": {"keyMap.keep": ["p"], "keyConflicts": [], "menuKeys.keep": "P", "menuKeys.openSettings": "⌘,"}},
    {"snapshot": "09-keys", "window": "settings"},
    {"settingsWindow": "close"},

    {"log": "With the analysed sample open, each detection pane counts what its controls flag."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"settingsWindow": "eyes"},
    {"expect": {"settingsWindow.lines.eyesClosedBelow": "Eyes closed: 0 photos", "tuningScope.hasOwnTuning": false}},
    {"snapshot": "10-eyes-with-shoot", "window": "settings"},
    {"settingsWindow": "blur"},
    {"expect": {"settingsWindow.lines.blurryBelow": "Blurry: 18 photos", "settingsWindow.lines.blurryCertainBelow": "Certain: 6 photos"}},
    {"snapshot": "11-blur-with-shoot", "window": "settings"},
    {"settingsWindow": "similarity"},
    {"expect": {"settingsWindow.lines.stackGapSeconds": "In stacks: 14 photos", "settingsWindow.lines.bestPickSharpnessMargin": null}},
    {"snapshot": "12-similarity-with-shoot", "window": "settings"},
    {"settingsWindow": "duplicates"},
    {"expect": {"settingsWindow.lines.findExactDuplicates": "Exact copies: 2 photos", "settingsWindow.lines.nearDuplicateDistance": "Near-duplicates: 4 photos"}},
    {"snapshot": "13-duplicates-with-shoot", "window": "settings"},
    {"settingsWindow": "exposure"},
    {"expect": {"settingsWindow.lines.flagExposure": "Exposure: 2 photos"}},
    {"snapshot": "14-exposure-with-shoot", "window": "settings"},
    {"settingsWindow": "other"},
    {"expect": {"settingsWindow.lines.tiltedHorizonAboveDegrees": "Tilted horizon: off", "settingsWindow.lines.flagTiltedHorizon": null, "settingsWindow.lines.flagCutOffFaces": "Face cut off: 0 photos"}},
    {"snapshot": "15-other-with-shoot", "window": "settings"},
    {"dump": "15-other", "photos": false},
    {"settingsWindow": "close"},
    {"quit": true}
  ]
}
