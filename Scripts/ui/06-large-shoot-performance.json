{
  "needs": {"reset": true, "shoot": "5000", "slow": true, "timeout": 900},
  "timeout": 600,
  "window": [1440, 900],
  "steps": [
    {"log": "Run with --reset --shoot <a shoot made with make_sample_shoot.py --count 5000>."},
    {"resetStalls": true},
    {"open": "$SHOOT", "timeout": 300},
    {"wait": "idle", "timeout": 120},
    {"snapshot": "01-opened"},
    {"dump": "01-opened", "photos": false},
    {"sleep": 0.3},
    {"resetStalls": true},
    {"key": "pagedown", "repeat": 80, "interval": 0.05},
    {"key": "down", "repeat": 150, "interval": 0.03},
    {"key": "end"},
    {"wait": "idle", "timeout": 60},
    {"snapshot": "02-scrolled-to-end"},
    {"dump": "02-scrolled", "photos": false},
    {"sleep": 0.3},
    {"resetStalls": true},
    {"key": "x", "repeat": 40, "interval": 0.03},
    {"key": "cmd+a"},
    {"key": "p"},
    {"key": "cmd+z"},
    {"group": "rejected"},
    {"group": "unreviewed"},
    {"key": "home"},
    {"key": "pageup", "repeat": 5},
    {"wait": "idle", "timeout": 60},
    {"dump": "03-culled", "photos": false},
    {"sleep": 4},
    {"quit": true}
  ]
}
