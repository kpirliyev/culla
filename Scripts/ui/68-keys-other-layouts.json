{
  "needs": {
    "reset": true
  },
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. Keys count by position when a layout types letters bindings are not written with: on the Russian layout the P key types «з» and keeps, the X key «ч» and rejects, the U key «г» and clears, ⌘ with «я» on the Z key undoes; on the Turkmen layout «ž» on the X key rejects. A key recorded in Settings ▸ Keys on the Russian layout is stored as its Latin position."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"group": "allPhotos"},
    {"settings": {"collapseStacksInAllPhotos": false, "advanceAfterDecision": false}},
    {"wait": "idle"},
    {"click": "sonoma_2.jpg"},
    {"key": "з", "keyCode": 35},
    {"expect": {"photo:sonoma_2.jpg.decision": "kept"}},
    {"click": "sonoma_3.jpg"},
    {"key": "ч", "keyCode": 7},
    {"expect": {"photo:sonoma_3.jpg.decision": "rejected"}},
    {"key": "г", "keyCode": 32},
    {"expect": {"photo:sonoma_3.jpg.decision": "unreviewed"}},
    {"key": "я", "keyCode": 6, "modifiers": "cmd"},
    {"expect": {"photo:sonoma_3.jpg.decision": "rejected"}},
    {"click": "sonoma_4.jpg"},
    {"key": "ž", "keyCode": 7},
    {"expect": {"photo:sonoma_4.jpg.decision": "rejected"}},
    {"log": "A typed ASCII character still wins over the position: X typed on the P key's position (as on a layout that moves letters) rejects."},
    {"click": "horizon_1.jpg"},
    {"key": "x", "keyCode": 35},
    {"expect": {"photo:horizon_1.jpg.decision": "rejected"}},
    {"log": "Settings ▸ Keys: «л» on the K key records K."},
    {"settingsWindow": "keys"},
    {"bindKey": "keep", "typed": "л", "keyCode": 40},
    {"expect": {"keyMap.keep": ["k"], "menuKeys.keep": "K"}},
    {"settingsWindow": "close"},
    {"click": "horizon_3.jpg"},
    {"key": "л", "keyCode": 40},
    {"expect": {"photo:horizon_3.jpg.decision": "kept"}},
    {"settingsWindow": "keys"},
    {"keyRecorder": "resetAll"},
    {"expect": {"keyMap.keep": ["p"]}},
    {"settingsWindow": "close"},
    {"quit": true}
  ]
}
