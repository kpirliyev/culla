{
  "needs": {"reset": true, "shoot": "2000", "slow": true, "timeout": 600},
  "timeout": 540,
  "window": [1440, 900],
  "steps": [
    {"log": "Run with --reset --shoot <make_sample_shoot.py --count 2000>. Culling while analysis runs: paging the grid, stepping and deciding in the loupe, with the longest main-thread stall of each; then the speed of analysis, memory at peak and the time to the first group count."},
    {"open": "$SHOOT", "timeout": 300},
    {"wait": "idle", "timeout": 120},
    {"sleep": 6},
    {"snapshot": "01-analysing"},
    {"dump": "01-analysing", "photos": false},
    {"expect": {"analysis.phase": "running"}},
    {"sleep": 0.5},
    {"resetStalls": true},
    {"key": "pagedown", "repeat": 40, "interval": 0.05},
    {"key": "pageup", "repeat": 20, "interval": 0.05},
    {"wait": "idle", "timeout": 60},
    {"dump": "02-paged-grid", "photos": false},
    {"group": "blurry"},
    {"wait": "idle", "timeout": 60},
    {"snapshot": "03-blurry-filling"},
    {"group": "allPhotos"},
    {"key": "space"},
    {"wait": "idle", "timeout": 60},
    {"sleep": 0.3},
    {"resetStalls": true},
    {"key": "right", "repeat": 60, "interval": 0.05},
    {"keys": ["x", "p", "x", "p", "x", "p", "x", "p", "x", "p", "x", "p", "x", "p", "x", "p", "x", "p", "x", "p"], "interval": 0.08},
    {"wait": "idle", "timeout": 60},
    {"dump": "04-loupe-culling", "photos": false},
    {"expect": {"analysis.phase": "running", "totals.kept": 10, "totals.rejected": 10}},
    {"key": "space"},
    {"wait": "analysis", "timeout": 400},
    {"snapshot": "05-analysed"},
    {"dump": "05-analysed", "photos": false},
    {"expect": {"analysis.phase": "finished", "totals.kept": 10, "totals.rejected": 10}},
    {"quit": true}
  ]
}
