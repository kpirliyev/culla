{
  "needs": {"reset": true, "shoot": "2000", "slow": true, "timeout": 600},
  "timeout": 600,
  "window": [1280, 800],
  "steps": [
    {"log": "Timing on 2,000 photos with 500 rejects: opening Review and Apply, applying and undoing; the longest main-thread stall in each."},
    {"open": "$SHOOT"},
    {"analysis": "pause"},
    {"wait": "idle"},
    {"saveHash": "49-original"},
    {"click": 0},
    {"click": 499, "modifiers": "shift"},
    {"key": "x"},
    {"wait": "idle"},
    {"dump": "00-rejected", "photos": false},
    {"resetStalls": true},
    {"applyScreen": "open"},
    {"dump": "01-open", "photos": false},
    {"snapshot": "01-screen-large"},
    {"log": "Drawing the snapshot holds the main thread; the measuring window starts after it."},
    {"sleep": 0.5},
    {"resetStalls": true},
    {"key": "shift+cmd+return"},
    {"wait": "applied", "timeout": 300},
    {"dump": "02-applied", "photos": false},
    {"expect": {"stall.windowLongestMs": 25}, "tolerance": 25},
    {"resetStalls": true},
    {"bannerAction": "undo", "timeout": 300},
    {"dump": "03-undone", "photos": false},
    {"expect": {"stall.windowLongestMs": 25}, "tolerance": 25},
    {"expectHash": "49-original", "stamps": true},
    {"quit": true}
  ]
}
