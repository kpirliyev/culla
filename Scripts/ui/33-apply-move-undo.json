{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Review and Apply with several reason groups, the three actions, then Move to _Rejected and Undo Apply: the folder's files and their dates are as they were."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"saveHash": "33-original"},

    {"log": "Reject photos for several reasons: Certain blurry ones with ⇧X, the exposure group, a duplicate copy, one by hand; keep and rate one."},
    {"group": "blurry"},
    {"key": "shift+x"},
    {"confirm": true},
    {"group": "exposure"},
    {"wait": "idle"},
    {"key": "x"},
    {"key": "x"},
    {"group": "duplicates"},
    {"wait": "idle"},
    {"key": "return"},
    {"group": "allPhotos"},
    {"click": "horizon_1.jpg"},
    {"key": "x"},
    {"click": "sonoma_2.jpg"},
    {"key": "p"},
    {"click": "sonoma_2.jpg"},
    {"key": "4"},
    {"wait": "idle"},
    {"dump": "00-before", "photos": true},

    {"log": "⌘Return opens the screen: the summary, the rejects under their reasons, the choice and its consequences."},
    {"key": "cmd+return"},
    {"wait": "apply"},
    {"snapshot": "01-screen-move"},
    {"dump": "01-screen", "photos": false},
    {"expect": {"apply.screenOpen": true, "apply.action": "moveToRejectedFolder", "apply.writeSidecars": true, "apply.plan.blocker": null, "applyScreenShown": true,
      "apply.plan.kept": 2, "apply.plan.rejected": 9, "apply.plan.unreviewed": 23, "apply.buttonTitle": "Move 9 Photos to _Rejected",
      "apply.groups.0.reason": "blurry", "apply.groups.1.reason": "clippedShadows", "apply.groups.2.reason": "noFlag", "apply.groups.0.photos.5": "sonoma_1 copy.jpg"}},

    {"log": "The other two actions, with their consequences and button titles."},
    {"applyAction": "markOnly"},
    {"wait": "idle"},
    {"snapshot": "02-screen-mark-only"},
    {"expect": {"apply.buttonTitle": "Mark 9 Photos as Rejected"}},
    {"applyAction": "moveToTrash"},
    {"wait": "idle"},
    {"snapshot": "03-screen-trash"},
    {"expect": {"apply.buttonTitle": "Move 9 Photos to the Trash", "apply.differsFromDefault": true}},
    {"applyAction": "moveToRejectedFolder"},

    {"log": "A closer look at the focused reject with Space, and back."},
    {"key": "right"},
    {"key": "space"},
    {"wait": "idle"},
    {"snapshot": "04-peek"},
    {"key": "space"},

    {"log": "⇧⌘Return applies."},
    {"key": "shift+cmd+return"},
    {"wait": "applied"},
    {"snapshot": "05-applied-banner"},
    {"dump": "05-applied", "listing": true},
    {"expect": {"apply.screenOpen": false, "apply.result.state": "done", "apply.banner.kind": "result", "canUndo": false,
      "apply.result.headline": "9 photos moved to _Rejected", "apply.result.movedFiles": 9, "apply.result.sidecarsWritten": 11,
      "totals.photos": 26, "totals.rejected": 0, "undoTitle": "Undo Apply: Move 9 Photos to _Rejected…",
      "apply.undoable.title": "Move 9 Photos to _Rejected", "disk.listing.dirs": ["_Rejected", "sub"]}},

    {"log": "The grid and the loupe after the apply: the rejects have left the shoot; ⌘Z offers Undo Apply."},
    {"wait": "idle"},
    {"snapshot": "06-grid-after"},
    {"key": "space"},
    {"wait": "idle"},
    {"snapshot": "07-loupe-after"},
    {"key": "escape"},

    {"log": "Reveal Keepers and Open Keepers In are recorded, not performed."},
    {"settings": {"editorApplication": "/Applications/Photomator.app"}},
    {"bannerAction": "reveal"},
    {"bannerAction": "openKeepers"},
    {"wait": "idle"},
    {"snapshot": "08-banner-with-editor"},
    {"expect": {"apply.lastFileAction": "openKeepers: Photomator: 25 files"}},

    {"log": "Undo from the banner: everything comes back."},
    {"bannerAction": "undo"},
    {"snapshot": "09-undone"},
    {"dump": "09-undone", "listing": true},
    {"expectHash": "33-original"},
    {"expect": {"totals.photos": 35, "totals.rejected": 9, "totals.kept": 2, "photo:sonoma_2.jpg.rating": 4, "photo:horizon_1.jpg.decision": "rejected",
      "apply.undoReport.state": "undone", "apply.undoable": null, "disk.listing.dirs": ["sub"]}},
    {"quit": true}
  ]
}
