{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Fresh state expected: run with --reset. Columns are 5 at this window size."},
    {"open": "$SHOOT"},
    {"wait": "idle"},
    {"expect": {"focus": "sub/Big Sur Coastline.jpg", "gridColumns": 5, "canUndo": false}},

    {"key": "p"},
    {"expect": {"photo:sub/Big Sur Coastline.jpg.decision": "kept", "focus": "sub/Big Sur Horizon.jpg",
                "totals.kept": 1, "undoTitle": "Undo Keep"}},
    {"key": "x"},
    {"expect": {"photo:sub/Big Sur Horizon.jpg.decision": "rejected", "focus": "sub/Big Sur Aerial.jpg",
                "totals.rejected": 1, "undoTitle": "Undo Reject"}},
    {"key": "3"},
    {"expect": {"photo:sub/Big Sur Aerial.jpg.rating": 3, "focus": "sub/Big Sur Aerial.jpg", "undoTitle": "Undo Rate 3 Stars"}},
    {"key": "u"},
    {"expect": {"photo:sub/Big Sur Aerial.jpg.decision": "unreviewed", "focus": "sonoma_0.jpg"}},

    {"keys": ["left", "shift+right", "shift+right"]},
    {"expect": {"selectionCount": 3, "focus": "sonoma_0_blur1.5.jpg",
                "selection": ["sub/Big Sur Aerial.jpg", "sonoma_0.jpg", "sonoma_0_blur1.5.jpg"]}},
    {"key": "x"},
    {"expect": {"totals.rejected": 4, "selectionCount": 3, "undoTitle": "Undo Reject 3 Photos",
                "photo:sonoma_0.jpg.decision": "rejected"}},
    {"key": "5"},
    {"expect": {"photo:sonoma_0.jpg.rating": 5, "photo:sub/Big Sur Aerial.jpg.rating": 5,
                "undoTitle": "Undo Rate 3 Photos 5 Stars"}},
    {"wait": "idle"},
    {"snapshot": "01-bulk-reject-and-rate"},

    {"key": "cmd+z"},
    {"expect": {"photo:sonoma_0.jpg.rating": 0, "photo:sub/Big Sur Aerial.jpg.rating": 3,
                "canRedo": true, "redoTitle": "Redo Rate 3 Photos 5 Stars"}},
    {"key": "cmd+z"},
    {"expect": {"totals.rejected": 1, "photo:sub/Big Sur Aerial.jpg.decision": "unreviewed", "selectionCount": 3}},
    {"key": "shift+cmd+z"},
    {"expect": {"totals.rejected": 4, "canRedo": true, "redoTitle": "Redo Rate 3 Photos 5 Stars"}},

    {"click": "sonoma_1.jpg"},
    {"click": "sonoma_3.jpg", "modifiers": "cmd"},
    {"expect": {"selection": ["sonoma_1.jpg", "sonoma_3.jpg"], "focus": "sonoma_3.jpg"}},
    {"key": "p"},
    {"expect": {"totals.kept": 3, "totals.rejected": 4, "canRedo": false, "undoTitle": "Undo Keep 2 Photos"}},
    {"key": "down"},
    {"expect": {"focus": "sonoma_burst2.jpg", "selectionCount": 1}},
    {"key": "cmd+a"},
    {"expect": {"selectionCount": 35}},
    {"key": "shift+cmd+a"},
    {"expect": {"selectionCount": 1}},

    {"group": "unreviewed"},
    {"expect": {"visibleCount": 27, "focus": "sonoma_0_blur3.jpg", "viewMode": "loupe"}},
    {"key": "home"},
    {"expect": {"focus": "sonoma_0_blur3.jpg"}},
    {"key": "p"},
    {"expect": {"visibleCount": 26, "focus": "sonoma_0_blur6.jpg", "totals.kept": 4, "totals.left": 26,
                "groups.unreviewed.total": 26, "groups.allPhotos.left": 26}},
    {"wait": "idle"},
    {"snapshot": "02-unreviewed-after-keep"},

    {"group": "allPhotos"},
    {"command": "smallerThumbnails", "repeat": 2},
    {"expect": {"thumbnailSize": 88}},
    {"wait": "idle"},
    {"snapshot": "03-small-thumbnails"},
    {"command": "largerThumbnails", "repeat": 2},

    {"group": "rejected"},
    {"click": 1},
    {"key": "space"},
    {"wait": "idle"},
    {"expect": {"currentGroup": "rejected", "focus": "sub/Big Sur Aerial.jpg", "viewMode": "loupe"}},
    {"snapshot": "04-loupe-rejected"},
    {"dump": "final"},
    {"quit": true}
  ]
}
