{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. Synthetic scores, pinned while real analysis runs (the sample has no faces): Eyes Closed opens zoomed to the closed eyes; Z zooms to the worst eyes in Eyes Closed and to the focus point elsewhere, Tab and Shift-Tab step through the main faces, B toggles face boxes."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 120},
    {"injectScores": {
      "sonoma_burst0.jpg": {"faces": [
          {"box": [0.30, 0.30, 0.12, 0.18], "eyes": [0.35, 0.33]},
          {"box": [0.55, 0.25, 0.10, 0.15], "eyes": [0.30, 0.31]},
          {"box": [0.85, 0.70, 0.03, 0.04], "eyes": [0.30, 0.30]}],
        "focus": [0.36, 0.38]},
      "sonoma_burst1.jpg": {"faces": [
          {"box": [0.30, 0.30, 0.12, 0.18], "eyes": [0.34, 0.32]},
          {"box": [0.55, 0.25, 0.10, 0.15], "eyes": [0.08, 0.10]},
          {"box": [0.85, 0.70, 0.03, 0.04], "eyes": [0.05, 0.05]}],
        "focus": [0.36, 0.38]},
      "sonoma_burst2.jpg": {"faces": [], "focus": [0.7, 0.6]},
      "sonoma_burst3.jpg": null
    }},
    {"expect": {"groups.eyesClosed.total": 1, "photo:sonoma_burst1.jpg.flags": ["eyesClosed"],
                "photo:sonoma_burst1.jpg.mainFaces": [0, 1], "photo:sonoma_burst0.jpg.flags": []}},

    {"log": "Eyes Closed opens with face boxes on. Z zooms to the eyes of the face with the most closed eyes (face 1)."},
    {"group": "eyesClosed"},
    {"wait": "idle"},
    {"snapshot": "01-eyes-closed-opens-zoomed"},
    {"expect": {"focus": "sonoma_burst1.jpg", "viewMode": "loupe", "loupe.faceBoxes": true, "loupe.clipping": false,
                "loupe.faceOrder": [0, 1], "loupe.zoomPercent": 100, "loupe.targetedFace": 1}},
    {"expect": {"loupe.visibleCentre": [0.6, 0.31]}, "tolerance": 0.002},
    {"key": "z"},
    {"wait": "idle"},
    {"snapshot": "01b-eyes-closed-fit"},
    {"expect": {"loupe.isFit": true}},
    {"key": "z"},
    {"wait": "idle"},
    {"snapshot": "02-zoomed-to-closed-eyes"},
    {"dump": "02-zoomed", "photos": false},
    {"expect": {"loupe.zoomPercent": 100, "loupe.targetedFace": 1}},
    {"expect": {"loupe.visibleCentre": [0.6, 0.31]}, "tolerance": 0.002},

    {"log": "Tab: the next main face in reading order, wrapping round; Shift-Tab back."},
    {"key": "tab"},
    {"wait": "idle"},
    {"expect": {"loupe.targetedFace": 0, "loupe.zoomPercent": 100}},
    {"expect": {"loupe.visibleCentre": [0.36, 0.372]}, "tolerance": 0.002},
    {"snapshot": "03-tab-to-face-0"},
    {"key": "tab"},
    {"expect": {"loupe.targetedFace": 1}},
    {"key": "shift+tab"},
    {"expect": {"loupe.targetedFace": 0}},
    {"key": "b"},
    {"wait": "idle"},
    {"expect": {"loupe.faceBoxes": false}},
    {"key": "b"},
    {"expect": {"loupe.faceBoxes": true}},

    {"log": "All Photos: face boxes are off until B. Z goes to the focus point, which lies in face 0."},
    {"key": "z"},
    {"group": "allPhotos"},
    {"log": "All Photos collapses stacks to one tile: S shows every frame, so a frame can be clicked."},
    {"key": "s"},
    {"click": "sonoma_burst0.jpg"},
    {"log": "All Photos opens in the grid; Space shows the loupe."},
    {"key": "space"},
    {"wait": "idle"},
    {"expect": {"viewMode": "loupe", "loupe.faceBoxes": false, "loupe.isFit": true}},
    {"key": "b"},
    {"wait": "idle"},
    {"snapshot": "04-face-boxes-toggled"},
    {"expect": {"loupe.faceBoxes": true}},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"loupe.targetedFace": 0}},
    {"expect": {"loupe.visibleCentre": [0.36, 0.38]}, "tolerance": 0.002},
    {"key": "tab"},
    {"expect": {"loupe.targetedFace": 1}},

    {"log": "A photo with scores but no faces: Z goes to its focus point and Tab does nothing. Without scores: the middle."},
    {"key": "right"},
    {"key": "right"},
    {"wait": "idle"},
    {"expect": {"focus": "sonoma_burst2.jpg", "loupe.targetedFace": null, "loupe.faceOrder": []}},
    {"key": "z"},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"loupe.zoomPercent": 100}},
    {"expect": {"loupe.visibleCentre": [0.647, 0.6]}, "tolerance": 0.002},
    {"command": "nextFace", "allowUnavailable": true},
    {"expect": {"loupe.targetedFace": null}},
    {"key": "right"},
    {"key": "z"},
    {"key": "z"},
    {"wait": "idle"},
    {"expect": {"focus": "sonoma_burst3.jpg", "loupe.zoomPercent": 100}},
    {"expect": {"loupe.visibleCentre": [0.5, 0.5]}, "tolerance": 0.002},
    {"dump": "final", "photos": false},
    {"quit": true}
  ]
}
