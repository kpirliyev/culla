{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Mark Only: no file moves; rejects get a sidecar saying rejected (rating -1, Red); kept ones Green with their stars. Undo removes the sidecars again."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"saveHash": "34-original"},
    {"group": "allPhotos"},
    {"click": "horizon_1.jpg"},
    {"key": "x"},
    {"click": "sonoma_3.jpg"},
    {"key": "x"},
    {"click": "horizon_0_under.jpg"},
    {"key": "x"},
    {"wait": "idle"},
    {"click": "sonoma_2.jpg"},
    {"key": "p"},
    {"click": "sonoma_2.jpg"},
    {"key": "3"},
    {"applyScreen": "open"},
    {"applyAction": "markOnly"},
    {"wait": "idle"},
    {"snapshot": "01-mark-only"},
    {"expect": {"apply.buttonTitle": "Mark 3 Photos as Rejected", "apply.plan.sidecarsToWrite": 4}},
    {"applyAction": "markOnly", "sidecars": false},
    {"wait": "idle"},
    {"snapshot": "02-mark-only-without-sidecars"},
    {"expect": {"apply.buttonTitle": "Nothing to Apply", "apply.canApply": false}},
    {"applyAction": "markOnly", "sidecars": true},
    {"key": "shift+cmd+return"},
    {"wait": "applied"},
    {"snapshot": "03-marked"},
    {"dump": "03-marked", "listing": true},
    {"expect": {"apply.result.headline": "3 photos marked as rejected", "totals.photos": 35, "totals.rejected": 3, "canUndo": false, "undoTitle": "Undo Apply: Mark 3 Photos as Rejected…", "disk.listing.dirs": ["sub"]}},
    {"fileContains": "horizon_1.xmp", "text": ["xmp:Rating", "-1", "Red"]},
    {"fileContains": "sonoma_2.xmp", "text": ["Green", "3"]},
    {"log": "⌘Z after an apply asks to undo the apply."},
    {"key": "cmd+z"},
    {"wait": "confirmation"},
    {"snapshot": "04-undo-confirmation"},
    {"confirm": true, "question": "Undo “Mark 3 Photos as Rejected”?"},
    {"wait": "undone"},
    {"snapshot": "05-undone"},
    {"expectHash": "34-original"},
    {"expect": {"apply.undoReport.state": "undone", "totals.rejected": 3}},
    {"quit": true}
  ]
}
