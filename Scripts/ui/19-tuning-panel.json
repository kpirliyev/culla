{
  "needs": {"reset": true},
  "timeout": 180,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. The tuning panel: moving a threshold regroups at once with a live count, nothing is analysed again, no decision changes, and the value is kept in the settings. Stack settings regroup off the main thread."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"group": "blurry"},
    {"wait": "idle"},
    {"key": "p"},
    {"expect": {"photo:sonoma_0.jpg.decision": "kept", "groups.blurry.total": 18}},
    {"popover": "tuning"},
    {"snapshot": "01-tuning-panel"},
    {"expect": {"tuningPanel.group": "blurry", "tuningPanel.shown": true, "tuningPanel.lines": ["Blurry: 18 photos", "Certain: 6 photos"]}},
    {"tuning": {"blurryBelow": 15}},
    {"wait": "grouping", "timeout": 30},
    {"snapshot": "02-tuning-moved"},
    {"dump": "02-moved", "photos": false},
    {"expect": {"tuning.blurryBelow": 15, "tuningPanel.lines": ["Blurry: 18 → 6 photos", "Certain: 6 photos"],
                "groups.blurry.total": 6, "photo:sonoma_0.jpg.decision": "kept", "analysis.analysedThisOpen": 34}},
    {"tuning": {"reset": "blurry"}},
    {"expect": {"tuning.blurryBelow": 25, "groups.blurry.total": 18, "photo:sonoma_0.jpg.decision": "kept"}},
    {"popover": "close"},

    {"log": "Stacks: a tighter visual distance splits them; regrouping happens off the main thread."},
    {"group": "similarStacks"},
    {"wait": "idle"},
    {"popover": "tuning"},
    {"expect": {"stackCount": 5}},
    {"tuning": {"stackDistance": 0.1}},
    {"wait": "grouping", "timeout": 30},
    {"snapshot": "03-stacks-tightened"},
    {"dump": "03-stacks", "photos": false},
    {"expect": {"tuning.stackDistance": 0.1, "analysis.analysedThisOpen": 34}},
    {"tuning": {"reset": "similarStacks"}},
    {"wait": "grouping", "timeout": 30},
    {"expect": {"stackCount": 5, "groups.similarStacks.total": 14}},
    {"popover": "close"},
    {"quit": true}
  ]
}
