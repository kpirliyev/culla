{
  "needs": {"reset": true},
  "timeout": 240,
  "window": [1280, 800],
  "steps": [
    {"log": "Run with --reset. A detection slider in Settings changes the default; the open shoot follows it, so the sidebar and the group change at once, the slider's count line says by how much, nothing is analysed again and decisions stay."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"group": "blurry"},
    {"wait": "idle"},
    {"key": "p"},
    {"expect": {"photo:sonoma_0.jpg.decision": "kept", "groups.blurry.total": 18}},
    {"settingsWindow": "blur"},
    {"expect": {"settingsWindow.lines.blurryBelow": "Blurry: 18 photos", "settingsWindow.lines.blurryCertainBelow": "Certain: 6 photos",
                "settingsWindow.scopeNote": "Defaults for every shoot. “CullaSampleShoot” uses them, and the counts are from it."}},
    {"settings": {"default": {"blurryBelow": 15}}},
    {"expect": {"tuningDefault.blurryBelow": 15, "tuning.blurryBelow": 15, "tuningScope.hasOwnTuning": false,
                "groups.blurry.total": 6, "settingsWindow.lines.blurryBelow": "Blurry: 18 → 6 photos",
                "photo:sonoma_0.jpg.decision": "kept", "analysis.analysedThisOpen": 34, "preset": "custom", "settingsWindow.preset": "custom"}},
    {"wait": "idle"},
    {"snapshot": "01-blur-pane-moved", "window": "settings"},
    {"snapshot": "02-main-window-follows"},
    {"dump": "02-moved", "photos": false},

    {"log": "A grouping value: stacks are recomputed off the main thread and the count follows."},
    {"settingsWindow": "similarity"},
    {"expect": {"settingsWindow.lines.stackDistance": "In stacks: 14 photos", "stackCount": 5}},
    {"settings": {"default": {"stackDistance": 0.1}}},
    {"wait": "grouping", "timeout": 30},
    {"expect": {"tuning.stackDistance": 0.1, "analysis.analysedThisOpen": 34}},
    {"snapshot": "03-similarity-tightened", "window": "settings"},
    {"dump": "03-stacks", "photos": false},
    {"settings": {"resetPane": "similarity"}},
    {"wait": "grouping", "timeout": 30},
    {"expect": {"stackCount": 5, "groups.similarStacks.total": 14, "tuning.stackDistance": 0.6}},

    {"log": "Reset Blur to Defaults: Balanced again everywhere."},
    {"settingsWindow": "blur"},
    {"settings": {"resetPane": "blur"}},
    {"expect": {"tuning.blurryBelow": 25, "groups.blurry.total": 18, "preset": "balanced", "photo:sonoma_0.jpg.decision": "kept"}},
    {"settingsWindow": "close"},
    {"quit": true}
  ]
}
