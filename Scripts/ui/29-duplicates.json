{
  "needs": {"reset": true},
  "timeout": 200,
  "window": [1280, 800],
  "steps": [
    {"log": "Duplicates opens in duplicate review: copies side by side with their file details, the copy to keep starred with its reason. Return accepts; P on another copy then Return keeps that one; Accept All Exact Duplicates clears every exact set in one step and never touches near-duplicates."},
    {"open": "$SHOOT"},
    {"wait": "analysis", "timeout": 150},
    {"group": "duplicates"},
    {"wait": "idle"},
    {"expect": {"viewMode": "duplicateReview", "duplicates.setIndex": 0, "duplicates.kind": "exact", "duplicates.pick": "sonoma_1.jpg",
                "duplicates.reason": "Keep: original name", "duplicates.current": "sonoma_1.jpg", "exactSetsLeft": 1, "nearSetsLeft": 2}},
    {"snapshot": "01-exact-set"},
    {"key": "return"},
    {"wait": "idle"},
    {"expect": {"photo:sonoma_1.jpg.decision": "kept", "photo:sonoma_1 copy.jpg.decision": "rejected", "undoTitle": "Undo Accept Duplicate Set",
                "duplicates.setIndex": 1, "duplicates.kind": "near", "duplicates.pick": "sonoma_4.jpg", "duplicates.reason": "Keep: highest resolution"}},
    {"snapshot": "02-near-set"},
    {"dump": "02-near-set", "photos": false},

    {"log": "Keep the other copy instead: → to it, P, Return."},
    {"key": "right"},
    {"key": "p"},
    {"key": "return"},
    {"wait": "idle"},
    {"expect": {"photo:sonoma_4_small.jpg.decision": "kept", "photo:sonoma_4.jpg.decision": "rejected", "duplicates.setIndex": 2}},
    {"key": "down"},
    {"wait": "idle"},
    {"expect": {"duplicates.setIndex": 2, "notice": "This is the last set."}},
    {"key": "up"},
    {"wait": "idle"},
    {"expect": {"duplicates.setIndex": 1}},

    {"log": "Undo the three steps, then Accept All Exact Duplicates: one set, one step, near sets untouched."},
    {"keys": ["cmd+z", "cmd+z", "cmd+z"]},
    {"wait": "idle"},
    {"expect": {"exactSetsLeft": 1, "nearSetsLeft": 2, "photo:sonoma_1.jpg.decision": "unreviewed"}},
    {"key": "shift+return"},
    {"wait": "idle"},
    {"expect": {"exactSetsLeft": 0, "nearSetsLeft": 2, "duplicates.lastBulkAccept": {"sets": 1, "rejected": 1},
                "notice": "Cleared 1 set, rejected 1 photo. ⌘Z takes it back.", "undoTitle": "Undo Accept 1 Exact Duplicate Set",
                "photo:sonoma_1.jpg.decision": "kept", "photo:sonoma_1 copy.jpg.decision": "rejected",
                "photo:sonoma_4.jpg.decision": "unreviewed"}},
    {"snapshot": "03-accepted-all-exact"},
    {"command": "acceptAllExactDuplicates", "allowUnavailable": true},
    {"expect": {"undoTitle": "Undo Accept 1 Exact Duplicate Set"}},
    {"key": "cmd+z"},
    {"wait": "idle"},
    {"expect": {"exactSetsLeft": 1, "photo:sonoma_1 copy.jpg.decision": "unreviewed"}},
    {"key": "shift+return"},
    {"log": "The rest one by one, to the end."},
    {"keys": ["return", "return"]},
    {"wait": "idle"},
    {"expect": {"duplicates.done": true, "nearSetsLeft": 0}},
    {"snapshot": "04-all-sets-decided"},
    {"quit": true}
  ]
}
